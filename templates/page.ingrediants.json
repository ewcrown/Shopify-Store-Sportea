        },
        "properties_6zEfr7": {
          "type": "properties",
          "settings": {
            "title": "Brazilian Maté",
            "desc": "This ingredient is a South American favorite that is preferred over coffee in many countries due to its lack of harsh acids and plentiful variety of naturally occurring vitamins, minerals, and trace elements. Brazilian Maté also acts to suppress the appetite while nourishing the body.",
