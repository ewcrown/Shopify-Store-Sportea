{% style %}
    .sportea-block * {
      color:#000;
    }
  .sportea-block li {
    margin-bottom:5px;
  }
  .sportea-block a strong,
  .sportea-block a {
    color:#dc232a !important;
  }
  .sportea-block p {
    font-size: 16px;
    margin-bottom:12px;
  }
  .sportea-block h3 {
    margin-bottom:12px;
  }
  .sportea-block h2 {
    font-size: 24px;
    font-weight: bold;
    margin-top: 30px;
    margin-bottom: 20px;
  }
  .sportea-content {
    font-size: 16px;
    color: #333;
    line-height: 1.6;
  }
{% endstyle %}
<section class="sportea-section">
  <div class="large-container">
    {% for block in section.blocks %}
      <div class="sportea-block sportea-block-{{ block.type }}">
        <{{ section.settings.heading_tag }}>{{ block.settings.title }}</{{ section.settings.heading_tag }}>
        <div class="sportea-content">{{ block.settings.content }}</div>
      </div>
    {% endfor %}
  </div>
</section>
{% schema %}
 {
  "name": "<> Content Section",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    }
  ],
  "blocks": [
    {
      "type": "why_choose",
      "name": "Why Choose Iced SPORTea?",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Why Choose Iced SPORTea?" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    },
    {
      "type": "cold_brew",
      "name": "Cold Brew Tea",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Cold Brew Tea: The Best Way to Enjoy Iced SPORTea" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    },
    {
      "type": "health_benefits",
      "name": "Health Benefits",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Iced Tea Benefits: More Than Just Refreshing" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    },
    {
      "type": "variations",
      "name": "Iced Tea Variations",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Iced Tea Variations: Creative Ways to Enjoy SPORTea" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    },
    {
      "type": "shop",
      "name": "Shop Iced SPORTea",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop Iced SPORTea – Find Your Perfect Pack" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Frequently Asked Questions" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "<> Content Section",
      "category": "Custom Sections",
      "blocks": [
        { "type": "why_choose" },
        { "type": "cold_brew" },
        { "type": "health_benefits" },
        { "type": "variations" },
        { "type": "shop" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
