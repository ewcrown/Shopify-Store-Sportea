<section
  id="ew-runner-lp-faq"
  class="ew-runner-lp-faq"
  style="--ew-runner-lp-faq-bg: {{ section.settings.background_color }};"
>
  <div class="large-container ew-runner-lp-faq__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="ew-runner-lp-faq__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ew-runner-lp-faq__list">
        {%- for block in section.blocks -%}
          <div
            class="ew-runner-lp-faq__item{% if forloop.first and section.settings.open_first %} is-open{% endif %}"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="ew-runner-lp-faq__trigger"
              aria-expanded="{% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %}"
            >
              <span class="ew-runner-lp-faq__question">{{ block.settings.question | escape }}</span>
              <span class="ew-runner-lp-faq__icon" aria-hidden="true">
                <svg class="ew-runner-lp-faq__icon-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>

            <div class="ew-runner-lp-faq__panel">
              {%- if block.settings.answer != blank -%}
                <div class="ew-runner-lp-faq__answer rte">{{ block.settings.answer }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('ew-runner-lp-faq');
    if (!section) return;

    function initFaqAccordion() {
      var items = section.querySelectorAll('.ew-runner-lp-faq__item');

      items.forEach(function (item) {
        var trigger = item.querySelector('.ew-runner-lp-faq__trigger');
        var panel = item.querySelector('.ew-runner-lp-faq__panel');
        if (!trigger || !panel || trigger.dataset.bound === 'true') return;

        trigger.dataset.bound = 'true';

        if (item.classList.contains('is-open')) {
          panel.style.maxHeight = panel.scrollHeight + 'px';
        }

        trigger.addEventListener('click', function () {
          var isOpen = item.classList.contains('is-open');

          items.forEach(function (otherItem) {
            if (otherItem === item) return;
            otherItem.classList.remove('is-open');
            var otherTrigger = otherItem.querySelector('.ew-runner-lp-faq__trigger');
            var otherPanel = otherItem.querySelector('.ew-runner-lp-faq__panel');
            if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
            if (otherPanel) otherPanel.style.maxHeight = '0px';
          });

          item.classList.toggle('is-open', !isOpen);
          trigger.setAttribute('aria-expanded', !isOpen ? 'true' : 'false');
          panel.style.maxHeight = !isOpen ? panel.scrollHeight + 'px' : '0px';
        });
      });
    }

    initFaqAccordion();
    document.addEventListener('shopify:section:load', initFaqAccordion);
  })();
</script>

{% schema %}
{
  "name": "Runner LP — FAQ",
  "tag": "section",
  "class": "ew-runner-lp-faq-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "FAQ question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Runner LP — FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Does SPORTea actually replace electrolytes like a sports drink?",
            "answer": "<p>Yes — SPORTea contains natural electrolytes and minerals to support hydration, without the added sugar and artificial ingredients found in most sports drinks.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Will it give me energy without a crash?",
            "answer": "<p>Yes. SPORTea delivers smooth, natural energy from real ingredients — without the sugar spike and crash of typical sports drinks.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I drink it during a run?",
            "answer": "<p>Absolutely. Cold-brewed Iced SPORTea is light, easy on the stomach, and great for hydration on long runs and hot days.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How do I make it?",
            "answer": "<p>For Arctic Iced Cold-Steep Prep: one bag, one quart, in the fridge overnight. Hot or iced, it's ready when you are.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is it really sugar-free and low calorie?",
            "answer": "<p>Yes. SPORTea has zero sugar and zero calories — no artificial colors, flavors, or preservatives.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What if I don't like it?",
            "answer": "<p>We stand behind SPORTea. Contact us if you're not satisfied — we'll make it right.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
