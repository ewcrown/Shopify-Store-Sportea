{{ 'prop.css' | asset_url | stylesheet_tag }}
<!-- Properties Section -->
<section class="gf-container" style="padding-top:40px ">
  <div class="gf-container__content">
    <h3 class="gf-container__title" style="padding-bottom:1rem;">{{ section.settings.title }}</h1>
    <p class="gf-container__description">
      {{ section.settings.description }}
    </p>
  </div>

  <div class="gf-container__images">
    {% if section.settings.image %}
      <img
        src="{{ section.settings.image | image_url }}"
        alt="{{ section.settings.title }}"
        class="gf-image gf-image--left"
      >
    {% endif %}
    {% if section.settings.image_2 %}
      <img
        src="{{ section.settings.image_2 | image_url }}"
        alt="{{ section.settings.title }}"
        class="gf-image gf-image--right"
      >
    {% endif %}
  </div>
  <div class="sportea-why-us-wrap">
    <div class="page-width">
      <ul>
        {% for block in section.blocks %}
          <li>
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url  }}" alt="Why Us Image" width="" height="" class="img-responsive">
            {% endif %}
            {% if block.settings.title %}
              <p class="sportea-color-white">{{ block.settings.title }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% if section.settings.link %}
    <div class="gf-container__cta">
      <a href="{{ section.settings.link }}" class="gf-button theme-btn">
        {{- section.settings.button }}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          xmlns:xlink="http://www.w3.org/1999/xlink"
          fill="#ffffff"
          height="800px"
          width="800px"
          version="1.1"
          id="Layer_1"
          viewBox="0 0 330 330"
          xml:space="preserve"
          role="presentation"
        >
          <path id="XMLID_27_" d="M15,180h263.787l-49.394,49.394c-5.858,5.857-5.858,15.355,0,21.213C232.322,253.535,236.161,255,240,255  s7.678-1.465,10.606-4.394l75-75c5.858-5.857,5.858-15.355,0-21.213l-75-75c-5.857-5.857-15.355-5.857-21.213,0  c-5.858,5.857-5.858,15.355,0,21.213L278.787,150H15c-8.284,0-15,6.716-15,15S6.716,180,15,180z"></path>
        </svg>
      </a>
    </div>
  {% endif %}
</section>

<!-- Section End -->
{% schema %}
  {
  "name": "Properties",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "title",
      "default": "Natural Energy & Hydration",
      "placeholder": "Natural Energy & Hydration"
    },
   {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "SPORTea® is a delicious, high-performance beverage formulated for active people desiring a nutritious alternative to coffee, soda, alcohol, and sugary athletic drinks",
      "placeholder": "SPORTea® is a delicious, high-performance beverage formulated for active people desiring a nutritious alternative to coffee, soda, alcohol, and sugary athletic drinks"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image",
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "right Image",
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Shop Now",
      "placeholder": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "link"
    }
  ],
  "blocks": [
    {
      "type": "left",
      "name": "left",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "title",
          "default": "title",
          "placeholder": "title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "image",
          "info": "image"
        }
      ]
    },
    {
      "type": "right",
      "name": "right",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "title",
          "default": "title",
          "placeholder": "title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "image",
          "info": "image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Properties"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
