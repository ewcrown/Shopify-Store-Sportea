<section
  id="ew-runner-lp-about"
  class="ew-runner-lp-about"
  style="--ew-runner-lp-about-bg: {{ section.settings.background_color }};"
>
  <div class="large-container ew-runner-lp-about__container">
    <div class="ew-runner-lp-about__grid">
      <div class="ew-runner-lp-about__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="ew-runner-lp-about__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="ew-runner-lp-about__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>

      <div class="ew-runner-lp-about__images">
        {%- if section.settings.image_left != blank -%}
          <div class="ew-runner-lp-about__image-wrap ew-runner-lp-about__image-wrap--left">
            {{
              section.settings.image_left
              | image_url: width: 800
              | image_tag:
                class: 'ew-runner-lp-about__image',
                loading: 'lazy',
                widths: '400, 600, 800',
                sizes: '(min-width: 990px) 280px, 45vw',
                alt: section.settings.image_left.alt
            }}
          </div>
        {%- else -%}
          <div class="ew-runner-lp-about__image-wrap ew-runner-lp-about__image-wrap--left ew-runner-lp-about__image-wrap--placeholder" aria-hidden="true"></div>
        {%- endif -%}

        {%- if section.settings.image_right != blank -%}
          <div class="ew-runner-lp-about__image-wrap ew-runner-lp-about__image-wrap--right">
            {{
              section.settings.image_right
              | image_url: width: 900
              | image_tag:
                class: 'ew-runner-lp-about__image',
                loading: 'lazy',
                widths: '450, 700, 900',
                sizes: '(min-width: 990px) 320px, 50vw',
                alt: section.settings.image_right.alt
            }}
          </div>
        {%- else -%}
          <div class="ew-runner-lp-about__image-wrap ew-runner-lp-about__image-wrap--right ew-runner-lp-about__image-wrap--placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Runner LP — About",
  "tag": "section",
  "class": "ew-runner-lp-about-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f9f9fb"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Runners, For Runners."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We didn't make another lab-engineered sports drink. SPORTea is the real-ingredient tea that runners have relied on for decades — to fuel long runs, replace what they sweat out, and skip the sugar crash that wrecks the back half of a workout.</p>"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left image"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Right image"
    }
  ],
  "presets": [
    {
      "name": "Runner LP — About"
    }
  ]
}
{% endschema %}
