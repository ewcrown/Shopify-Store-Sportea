<section
  id="ew-runner-lp-about"
  class="ew-runner-lp-about"
  style="--ew-runner-lp-about-bg: {{ section.settings.background_color }};"
>
  <div class="large-container ew-runner-lp-about__container">
    <div class="ew-runner-lp-about__grid">
      <div class="ew-runner-lp-about__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="ew-runner-lp-about__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="ew-runner-lp-about__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.video_url != blank -%}
        <div class="ew-runner-lp-about__video">
          {%- if section.settings.video_title != blank -%}
            <h3 class="ew-runner-lp-about__heading ew-runner-lp-about__video-title">
              {{ section.settings.video_title | escape }}
            </h3>
          {%- endif -%}

          <div class="ew-runner-lp-about__video-embed">
            {%- if section.settings.video_url.type == 'youtube' -%}
              <iframe
                src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}"
                title="{{ section.settings.video_title | default: 'SPORTea for Half Marathon Prep' | escape }}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {%- elsif section.settings.video_url.type == 'vimeo' -%}
              <iframe
                src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}"
                title="{{ section.settings.video_title | default: 'SPORTea for Half Marathon Prep' | escape }}"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Runner LP — About",
  "tag": "section",
  "class": "ew-runner-lp-about-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f9f9fb"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Runners, For Runners."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We didn't make another lab-engineered sports drink. SPORTea is the real-ingredient tea that runners have relied on for decades — to fuel long runs, replace what they sweat out, and skip the sugar crash that wrecks the back half of a workout.</p>"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video title",
      "default": "SPORTea for Half Marathon Prep"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=cOKVX9pMI0I",
      "info": "Use a YouTube or Vimeo URL"
    }
  ],
  "presets": [
    {
      "name": "Runner LP — About"
    }
  ]
}
{% endschema %}
