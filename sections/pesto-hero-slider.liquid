
<link rel="stylesheet" href="{{ 'ui-heroslider-section.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'ui-heroslider-section.css' | asset_url | stylesheet_tag }}</noscript>
{%- style -%}
    
{%- if section.settings.pesto_section_padding_top != blank -%}

    #{{ section.id }}.banner-section .items-carousel-items{
        padding-top: {{ section.settings.pesto_section_padding_top }}px !important;
    }
    @media (max-width:1200px){
        #{{ section.id }}.banner-section .items-carousel-items{
            padding-top: 42px !important;
        }
    }
{%- endif -%}

{%- if section.settings.pesto_section_padding_bottom != blank -%}

    #{{ section.id }}.banner-section .items-carousel-items{
        padding-bottom: {{ section.settings.pesto_section_padding_bottom }}px !important;
    }
    @media (max-width:1200px){
        #{{ section.id }}.banner-section .items-carousel-items{
            padding-bottom: 30px !important;
        }
    }
{%- endif -%}
    .banner-carousel .items-carousel-items.full-width{
        width: 100%;
    }
    .banner-section.banner-slideshow{
        padding: unset !important;
    }
{%- endstyle -%}

<div id="{{ section.id }}" class="banner-section banner-slideshow no-slider-area color-{{ section.settings.color_scheme }}">
    <div class="banner-carousel no-slider">
        <items-carousel>
            <div class="items-carousel-selector" data-flickity='{ "prevNextButtons": false, "pageDots": true }'>
                {% for block in section.blocks %}
                    {%- case block.type -%}
                        {%- when 'slider_item' -%}
                            <div class="items-carousel-items full-width">
                                {% render 'pesto-banner-three-no-slider-slideshow', block: block %}
                            </div>
                    {% endcase %}
                {% endfor %}
            </div>
        </items-carousel>
    </div>
</div>
{% schema %}
{ 
    "name": "Slideshow",
    "tag": "section",
    "class": "banner-slider-three",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "default": "background-1",
            "label": "Color scheme"
        },
        {
            "type": "header",
            "content": "Section padding"
        },
        {
            "type": "range",
            "id": "pesto_section_padding_top",
            "min": 0, 
            "max": 200,
            "step": 10,
            "unit": "px",
            "label": "t:sections.all.padding.padding_top",
            "default": 150
        },
        {
            "type": "range",
            "id": "pesto_section_padding_bottom",
            "min": 0,
            "max": 200,
            "step": 10,
            "unit": "px",
            "label": "t:sections.all.padding.padding_bottom",
            "default": 150
        }
    ],
    "blocks": [
        {
            "name": "Banner content",
            "type": "slider_item",
            "settings": [
                {
                    "type": "text",
                    "id": "slider_item_title",
                    "label": "Heading",
                    "default": "Banner image"
                },
                {
                    "type": "select",
                    "id": "slider_item_title_size",
                    "options": [
                        {
                        "value": "sm",
                        "label": "Small"
                        },
                        {
                        "value": "md",
                        "label": "Medium"
                        },
                        {
                        "value": "lg",
                        "label": "Large"
                        }
                    ],
                    "default": "lg",
                    "label": "Heading size"
                },
                {
                    "type": "textarea",
                    "id": "slider_item_content_one",
                    "label": "Content",
                    "default": "Tell your brand's story through images"
                },
                {
                    "type": "textarea",
                    "id": "slider_item_content_two",
                    "label": "Subheading",
                    "default": "Subheading"
                },
                {
                    "type": "range",
                    "id": "slider_item_title_width",
                    "label": "Content width",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "default": 100,
                    "unit": "%"
                },
                {
                    "type": "select",
                    "id": "image_placement",
                    "options": [
                    {
                        "value": "text_right",
                        "label": "Left"
                    },
                    {
                        "value": "text_left",
                        "label": "Right"
                    }
                    ],
                    "default": "text_left",
                    "label": "Desktop image position",
                    "info": "Only applies if the secondary image is enabled"
                },
                {
                    "type": "select",
                    "id": "text_placement",
                    "options": [
                    {
                        "value": "text_p_left",
                        "label": "Left"
                    },
                    {
                        "value": "text_p_center",
                        "label": "Center"
                    },
                    {
                        "value": "text_p_right",
                        "label": "Right"
                    }
                    ],
                    "default": "text_p_left",
                    "label": "Desktop text position",
                    "info": "Only applies if the secondary image is disable"
                },
                {
                    "type": "select",
                    "id": "text_alignment",
                    "options": [
                        {
                            "value": "left",
                            "label": "Left"
                        },
                        {
                            "value": "center",
                            "label": "Center"
                        },
                        {
                            "value": "right",
                            "label": "Right"
                        }
                    ],
                    "default": "left",
                    "label": "Text alignment"
                },
                {
                    "type": "text",
                    "id": "slider_item_button_label",
                    "label": "Button label",
                    "default": "Button",
                    "info": "Leave the label blank to hide the button"
                },
                {
                    "type": "url",
                    "id": "slider_item_button_link",
                    "label": "Button link"
                },
                {
                    "type": "image_picker",
                    "id": "slide_item_background_shap_image",
                    "label": "Background image"
                },
                {
                    "type": "video",
                    "id": "slide_item_video",
                    "label": "Video background",
                    "info": "Overrides the background image setting."
                },
                {
                    "type": "checkbox",
                    "id": "show_the_secondary_image",
                    "default": true,
                    "label": "Enable the secondary image"
                },
                {
                    "type": "image_picker",
                    "id": "slider_item_right_images",
                    "label": "Secondary image"
                },
                {
                    "type": "select",
                    "id": "banner_column_option",
                    "options": [
                        {
                        "value": "small",
                        "label": "Small"
                        },
                        {
                        "value": "medium",
                        "label": "Medium"
                        },
                        {
                        "value": "large",
                        "label": "Large"
                        }
                    ],
                    "default": "medium",
                    "label": "Image width in desktop",
                    "info": "The image is optimized for mobile devices automatically."
                },
                {
                    "type": "select",
                    "id": "banner_image_position",
                    "options": [
                        {
                            "value": "left",
                            "label": "Left"
                        },
                        {
                            "value": "center",
                            "label": "Center"
                        },
                        {
                            "value": "right",
                            "label": "Right"
                        }
                    ],
                    "default": "right",
                    "label": "Image alignment"
                },
                {
                    "type": "checkbox",
                    "id": "banner_image_overflow",
                    "label": "Secondary image can go outside the container"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Slideshow",
            "blocks": [
                {
                    "type": "slider_item"
                }
            ]
        }
    ]
}
{% endschema %}