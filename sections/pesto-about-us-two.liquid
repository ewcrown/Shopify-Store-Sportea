<link
  rel="stylesheet"
  href="{{ 'ui-about-section.css' | asset_url }}"
  media="print"
  onload="this.media='all'">
<noscript>{{ 'ui-about-section.css' | asset_url | stylesheet_tag }}</noscript>
{%- style -%}
  {%- if section.settings.pesto_section_padding_top != blank -%}
    #shopify-section-{{ section.id}} .about-section {
      padding-top: {{ section.settings.pesto_section_padding_top }}px;
    }
  {%- endif -%}
  
  {%- if section.settings.pesto_section_padding_bottom != blank -%}
    #shopify-section-{{ section.id}} .about-section {
      padding-bottom: {{ section.settings.pesto_section_padding_bottom }}px;
    }
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- case block.type -%}
    {%- when 'img_txt_heading' -%}
      #shopify-section-{{ section.id}} .about-section .content-box .sec-title.{{ block.id }} h2{
        font-size: {{ block.settings.about_content_title_font_size }}px;
        font-weight: {{ block.settings.about_content_title_font_weight }};
      }
      @media (max-width: 767px) {
          #shopify-section-{{ section.id}} .about-section .content-box .sec-title.{{ block.id }} h2{
          font-size: 44px;
        }
      }
      {%- when 'img_txt_text' -%}
        #shopify-section-{{ section.id}} .about-section .content-box .text.{{ block.id }} p.custom-para{
          font-size: {{ block.settings.about_content_font_size }}px !important;
        }
      {%- when 'img_txt_caption' -%}
        #shopify-section-{{ section.id}} .about-section .content-box .caption.{{ block.id }} h3.sec-title-taglin{
          font-size: {{ block.settings.about_caption_font_size }}px !important;
        }
    {%- endcase -%}
  {%- endfor -%}
 
{%- endstyle -%}

<div id="{{ section.id }}" class="about-section color-{{ section.settings.color_scheme }}">
  <div class="large-container">
    <div class="align-items-center row {% if section.settings.about_image_position == "image_position_right"%}flex-row-reverse{% endif %} clearfix">
      <div class="col-lg-6 col-md-12 col-sm-12 image-column">
        <figure class="image-box">
          {%- if section.settings.about_content_url != blank -%}
            <img
              data-src="{{ section.settings.about_content_url | img_url: 'master' }}"
              loading="lazy"
              class="lazyload"
              width="{{ section.settings.about_content_url.width }}"
              height="{{ section.settings.about_content_url.height }}"
              alt="{{ section.settings.about_content_url.alt | escape }}">
            {%- else -%}
              {{ 'collection-5' | placeholder_svg_tag: 'placeholder-svg-promo-two-two' }}
            {%- endif -%}
        </figure>
      </div>
      <div class="col-lg-6 col-md-12 col-sm-12 content-column">
        <div class="content-box"> 
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'img_txt_heading' -%}
                {%- if block.settings.about_content_title != blank -%}
                  <div class="sec-title {{ block.id }}">
                    <h2>{{ block.settings.about_content_title }}</h2>
                  </div>
                {%- endif -%}
              {%- when 'img_txt_text' -%}
                <div class="text {{ block.id }}">
                  {%- if block.settings.about_content_content != blank -%}
                    <p class="custom-para">{{ block.settings.about_content_content }}</p>
                  {%- endif -%}
                </div>
              {%- when 'img_txt_button' -%}
                {% if block.settings.about_content_link_text != blank %}
                  <div class="btn-box about-story-buttton">
                    {% if block.settings.about_content_link_text != blank %}
                      <a href="{{ block.settings.about_content_link }}" class="theme-btn btn-one">
                          {{ block.settings.about_content_link_text }}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- when 'img_txt_caption' -%}
                {%- if block.settings.about_content_caption != blank -%}
                  <div class="caption {{ block.id }}">
                    <h3 class="sec-title-taglin">
                      {{ block.settings.about_content_caption }}
                    </h3>
                  </div>
                {%- endif -%}
              {%- when 'icon_with_text' -%}
                {%- if block.settings.about_content_list_text != blank -%}
                  <div class="pesto-story-list-content">
                    {% if block.settings.pesto_icon_select_option == 'tick' %}
                      <span>{% render 'icon-right-tick' %}</span>
                      {% elsif block.settings.pesto_icon_select_option == 'none-icon' %}
                        <span>{% render 'icon-none' %}</span>
                        {% elsif block.settings.pesto_icon_select_option == 'leaf' %}
                          <span>{% render 'icon-leaf' %}</span>
                          {% elsif block.settings.pesto_icon_select_option == 'chemistry' %}
                            <span>{% render 'icon-chemistry' %}</span>
                            {% elsif block.settings.pesto_icon_select_option == 'organic' %}
                              <span>{% render 'icon-organic' %}</span>
                              {% else %}
                    {% endif %}
                            <p>
                              {{ block.settings.about_content_list_text }}
                              </p>
                  </div>
                {%- endif -%}
              {%- when 'contact_button' -%}
                <div class="pesto-contact-btn btn-box contact_button">
                  <a href="tel:{{ block.settings.contact_btn_number }}" class="">
                    <span class="icon">
                      <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" role="none">
                        <g clip-path="url(#clip0_4367_286)">
                        <path d="M31.6808 14.4009C31.6808 13.6061 31.0357 12.9609 30.2408 12.9609C29.4459 12.9609 28.8008 13.6061 28.8008 14.4009C28.8008 14.7437 28.8008 24.8582 28.8008 25.2009C28.8008 25.9958 29.4459 26.6409 30.2408 26.6409C31.0357 26.6409 31.6808 25.9958 31.6808 25.2009C31.6808 24.8582 31.6808 14.7437 31.6808 14.4009Z" stroke="currentColor" stroke-width="2" stroke-miterlimit="10"/>
                        <path d="M20.1611 33.8409C20.956 33.8409 21.6011 33.1958 21.6011 32.4009C21.6011 31.6061 20.956 30.9609 20.1611 30.9609C19.8184 30.9609 16.9038 30.9609 16.5611 30.9609C15.7662 30.9609 15.1211 31.6061 15.1211 32.4009C15.1211 33.1958 15.7662 33.8409 16.5611 33.8409C16.9038 33.8409 19.8184 33.8409 20.1611 33.8409Z" stroke="currentColor" stroke-width="2" stroke-miterlimit="10"/>
                        <path d="M5.75781 13.6775C5.75781 6.91742 11.2377 1.4375 17.9978 1.4375C24.7579 1.4375 30.2378 6.91742 30.2378 13.6775" stroke="currentColor" stroke-width="2" stroke-miterlimit="10"/>
                        <path d="M31.6797 14.3984C33.6683 14.3984 35.2797 16.8155 35.2797 19.7984C35.2797 22.78 33.6683 25.1984 31.6797 25.1984" stroke="currentColor" stroke-width="2" stroke-miterlimit="10"/>
                        <path d="M4.32031 14.4009C4.32031 13.6061 4.96543 12.9609 5.76031 12.9609C6.55519 12.9609 7.20031 13.6061 7.20031 14.4009C7.20031 14.7437 7.20031 24.8582 7.20031 25.2009C7.20031 25.9958 6.55519 26.6409 5.76031 26.6409C4.96543 26.6409 4.32031 25.9958 4.32031 25.2009C4.32031 24.8582 4.32031 14.7437 4.32031 14.4009Z" stroke="currentColor" stroke-width="2" stroke-miterlimit="10"/>
                        <path d="M4.31875 14.3984C2.33083 14.3984 0.71875 16.8155 0.71875 19.7984C0.71875 22.78 2.33083 25.1984 4.31875 25.1984" stroke="currentColor" stroke-width="2" stroke-miterlimit="10"/>
                        <path d="M30.2416 26.6406C30.2416 30.2406 28.0816 32.4006 24.4816 32.4006H21.6016" stroke="currentColor" stroke-width="2" stroke-miterlimit="10"/>
                        </g>
                        <defs>
                        <clipPath id="clip0_4367_286">
                        <rect width="36" height="36" fill="currentColor"/>
                        </clipPath>
                        </defs>
                      </svg>
                    </span>
                    <span>
                      <p>{{ block.settings. contact_btn_text}}</p>
                      <h4>{{ block.settings.contact_btn_number }}</h4>
                    </span>
                  </a>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div> 
    </div> 
  </div>
</div>
{% schema %}
  {
    "name": "Image with text",
    "tag": "section",
    "class": "about-two-info",
    "blocks": [
      {
        "name": "Heading",
        "type": "img_txt_heading",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "about_content_title",
            "default": "Heading.",
            "label": "Heading"
          },
          {
            "type": "range",
            "id": "about_content_title_font_size",
            "min": 36,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Size",
            "default": 72
          },
          {
            "type": "select",
            "id": "about_content_title_font_weight",
            "label": "Font weight",
            "default": "400",
            "options": [
              {
                "value": "400",
                "label": "Regular"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          }
        ]
      },
      {
        "name": "Text",
        "type": "img_txt_text",
        "settings": [
          {
            "type": "textarea",
            "id": "about_content_content",
            "default": "Describe a product, make announcements, or welcome customers to your store.",
            "label": "Content"
          },
          {
            "type": "range",
            "id": "about_content_font_size",
            "min": 16,
            "max": 36,
            "step": 1,
            "unit": "px",
            "label": "Size",
            "default": 18
          }
        ]
      },
      {
        "name": "Button",
        "type": "img_txt_button",
        "settings": [
          {
            "type": "text",
            "id": "about_content_link_text",
            "label": "Label",
            "default": "Button label",
            "info": "Leave the label blank to hide the button"
          },
          {
            "type": "url",
            "id": "about_content_link",
            "label": "Link"
          }
        ]
      },
      {
        "name": "Contact button",
        "type": "contact_button",
        "settings": [
          {
            "type": "text",
            "id": "contact_btn_text",
            "label": "Label",
            "default": "Label",
            "info": "Leave the label blank to hide the button"
          },
          {
            "type": "text",
            "id": "contact_btn_number",
            "label": "Phone number",
            "default": "098765432900"
          }
        ]
      },
      {
        "name": "Caption",
        "type": "img_txt_caption",
        "settings": [
          {
            "type": "text",
            "id": "about_content_caption",
            "default": "Add a tagline.",
            "label": "Caption"
          },
          {
            "type": "range",
            "id": "about_caption_font_size",
            "min": 16,
            "max": 36,
            "step": 1,
            "unit": "px",
            "label": "Size",
            "default": 18
          }
        ]
      },
      {
        "name": "Icon with text",
        "type": "icon_with_text",
        "settings": [
          {
            "type": "select",
            "id": "pesto_icon_select_option",
            "label": "Icon",
            "options": [
              {
                "value": "none",
                "label": "None"
              },
              {
                "value": "tick",
                "label": "Tick"
              },
              {
                "value": "none-icon",
                "label": "Restricted"
              },
              {
                "value": "leaf",
                "label": "Leaf"
              },
              {
                "value": "chemistry",
                "label": "Chemical"
              },
              {
                "value": "organic",
                "label": "Organic"
              }
            ],
            "default": "tick"
          },
          {
            "type": "text",
            "id": "about_content_list_text",
            "default": "Pair text with features",
            "label": "Text"
          }
        ]
      }
    ],
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "background-1",
        "label": "Color scheme"
      }, 
      {
        "type": "image_picker",
        "id": "about_content_url",
        "label": "Image"
      }, 
      {
        "type": "select",
        "id": "about_image_position",
        "label": "Image position",
        "default": "image_position_left",
        "options": [
          {
            "value": "image_position_left",
            "label": "Left"
          },
          {
            "value": "image_position_right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Section padding"
      }, 
      {
        "type": "range",
        "id": "pesto_section_padding_top",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 150
      }, 
      {
        "type": "range",
        "id": "pesto_section_padding_bottom",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 150
      }
    ],
    "presets": [
      {
        "name": "Image with text",
        "blocks": [
          {
            "type": "img_txt_heading"
          },
          {
            "type": "img_txt_text"
          },
          {
            "type": "img_txt_button"
          }
        ]
      }
    ]
  }
{% endschema %} 