<link rel="stylesheet" href="{{ 'ui-menu-section.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'ui-menu-section.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
    {%- if section.settings.padding_bottom_sections != '' -%}
        #{{ section.id }} {
            padding-bottom: {{ section.settings.padding_bottom_sections }}px !important;
        }
    {%- endif -%}
    {%- if section.settings.padding_top_sections != '' -%}
        #{{ section.id }} {
            padding-top: {{ section.settings.padding_top_sections }}px !important;
        }
    {%- endif -%}
{%- endstyle -%}




{% if section.settings.layout_type == 'normal' %}
    {%- render 'pesto-board-menu-normal' -%}
{% elsif section.settings.layout_type == 'card' %}
    {%- render 'pesto-board-menu-box' -%}
{% endif %}

{% schema %}
    {
        "name": "Highlighted collection",
        "tag": "section",
        "class": "pesto-board-menu-two",
        "settings": [
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "default": "background-3",
                "label": "Color scheme"
            },
            {
              "label": "Layout type",
              "id": "layout_type",
              "type": "select",
              "default": "card",
              "options": [
                {
                  "value": "normal",
                  "label": "Normal"
                },
                {
                  "value": "card",
                  "label": "Card"
                }
              ]
            },
            {
                "type": "image_picker",
                "id": "sections_bg",
                "label": "Image"
            },
            {
                "type": "text",
                "id": "title",
                "label": "Heading",
                "default": "Heading"
            },
            {
                "type": "header",
                "content": "Section padding"
            },
            {
              "type": "range",
              "id": "padding_top_sections",
              "min": 0,
              "max": 200,
              "step": 10,
              "unit": "px",
              "label": "Top padding",
              "default": 50
            },
            {
              "type": "range",
              "id": "padding_bottom_sections",
              "min": 0,
              "max": 200,
              "step": 10,
              "unit": "px",
              "label": "Bottom padding",
              "default": 50
            }
        ],
        "blocks": [
            {
                "name": "Collection",
                "type": "product_collections",
                "limit": 2,
                "settings": [
                    {
                        "type": "collection",
                        "id": "product_collection",
                        "label": "Select collection"
                    },
                    {
                      "type": "range",
                      "id": "product_collection_limit_one",
                      "min": 1,
                      "max": 20,
                      "step": 1,
                      "label": "Products per page",
                      "default": 5
                    }
                ]
            }
        ],
        "presets": [
            {
                "name": "Highlighted collection",
                "blocks": [
                    {
                        "type": "product_collections"
                    },
                    {
                        "type": "product_collections"
                    }
                ]
            }
        ]
    }
{% endschema %}