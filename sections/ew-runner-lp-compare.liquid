<section
  id="ew-runner-lp-compare"
  class="ew-runner-lp-compare"
  style="--ew-runner-lp-compare-bg: {{ section.settings.background_color }}; --ew-runner-lp-compare-cons-bg: {{ section.settings.cons_background_color }}; --ew-runner-lp-compare-pros-bg: {{ section.settings.pros_background_color }};"
>
  <div class="large-container ew-runner-lp-compare__container">
    <div class="ew-runner-lp-compare__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="ew-runner-lp-compare__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="ew-runner-lp-compare__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="ew-runner-lp-compare__row">
      <div class="ew-runner-lp-compare__column ew-runner-lp-compare__column--cons">
        <div class="ew-runner-lp-compare__card ew-runner-lp-compare__card--cons">
          {%- if section.settings.cons_title != blank -%}
            <h3 class="ew-runner-lp-compare__card-title">{{ section.settings.cons_title | escape }}</h3>
          {%- endif -%}

          <ul class="ew-runner-lp-compare__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'con' -%}
                <li class="ew-runner-lp-compare__list-item" {{ block.shopify_attributes }}>
                  <span class="ew-runner-lp-compare__icon ew-runner-lp-compare__icon--con" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                      <path d="M4.5 4.5L13.5 13.5M13.5 4.5L4.5 13.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </span>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>

      <div class="ew-runner-lp-compare__column ew-runner-lp-compare__column--image">
        {%- if section.settings.image != blank -%}
          <div class="ew-runner-lp-compare__image-wrap">
            {{
              section.settings.image
              | image_url: width: 900
              | image_tag:
                class: 'ew-runner-lp-compare__image',
                loading: 'lazy',
                widths: '400, 600, 900',
                sizes: '(min-width: 990px) 320px, 80vw',
                alt: section.settings.image.alt
            }}
          </div>
        {%- else -%}
          <div class="ew-runner-lp-compare__image-wrap ew-runner-lp-compare__image-wrap--placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>

      <div class="ew-runner-lp-compare__column ew-runner-lp-compare__column--pros">
        <div class="ew-runner-lp-compare__card ew-runner-lp-compare__card--pros">
          {%- if section.settings.pros_title != blank -%}
            <h3 class="ew-runner-lp-compare__card-title">{{ section.settings.pros_title | escape }}</h3>
          {%- endif -%}

          <ul class="ew-runner-lp-compare__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'pro' -%}
                <li class="ew-runner-lp-compare__list-item" {{ block.shopify_attributes }}>
                  <span class="ew-runner-lp-compare__icon ew-runner-lp-compare__icon--pro" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                      <path d="M4.5 9.25L7.5 12.25L13.5 6.25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Runner LP — Compare",
  "tag": "section",
  "class": "ew-runner-lp-compare-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Run Deserves Better Than A Sugar Bomb."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Most sports drinks fix one problem and create three. You get a hit of energy — then the crash. You get \"hydration\" — packaged with 30+ grams of sugar, artificial dyes, and a label you can't pronounce. For something you drink every single run, that adds up fast.</p>"
    },
    {
      "type": "header",
      "content": "Cons column"
    },
    {
      "type": "text",
      "id": "cons_title",
      "label": "Cons title",
      "default": "MOST SPORTS DRINKS"
    },
    {
      "type": "color",
      "id": "cons_background_color",
      "label": "Cons background color",
      "default": "#eef1f6"
    },
    {
      "type": "header",
      "content": "Center image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Pros column"
    },
    {
      "type": "text",
      "id": "pros_title",
      "label": "Pros title",
      "default": "SPORTEA"
    },
    {
      "type": "color",
      "id": "pros_background_color",
      "label": "Pros background color",
      "default": "#2b4e92"
    }
  ],
  "blocks": [
    {
      "type": "con",
      "name": "Con item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Loaded with sugar"
        }
      ]
    },
    {
      "type": "pro",
      "name": "Pro item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Zero sugar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Runner LP — Compare",
      "blocks": [
        { "type": "con", "settings": { "text": "Loaded with sugar" } },
        { "type": "con", "settings": { "text": "Sugar high, then a crash" } },
        { "type": "con", "settings": { "text": "Artificial colors & additives" } },
        { "type": "con", "settings": { "text": "Heavy, syrupy on the stomach" } },
        { "type": "pro", "settings": { "text": "Zero sugar" } },
        { "type": "pro", "settings": { "text": "Steady energy, no crash" } },
        { "type": "pro", "settings": { "text": "No artificial colors or additives" } },
        { "type": "pro", "settings": { "text": "Light, easy on the stomach" } }
      ]
    }
  ]
}
{% endschema %}
