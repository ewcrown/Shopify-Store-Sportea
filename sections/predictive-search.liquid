{%- if predictive_search.performed -%}
  <div id="predictive-search-results">
    {%- if predictive_search.resources.products.size > 0 -%}
      <h2 id="predictive-search-products" class="predictive-search__heading text-body caption-with-letter-spacing">
        {{ 'templates.search.products' | t }}
        <span class="hidden" data-predictive-search-live-region-count-value>
          {%- if search.results_count == 0 -%}
            {{ 'templates.search.no_results' | t: terms: predictive_search.terms }}
          {%- else -%}
            {{
              'templates.search.results_with_count'
              | t: terms: predictive_search.terms, count: predictive_search.resources.products.size
            }}
          {%- endif -%}
        </span>
      </h2>
    {%- endif -%}
    <div
      id="predictive-search-results-list"
      class="shop-page-section predictive-search__results-list list-unstyled"
      role="listbox"
      aria-labelledby="predictive-search-products"
    >
      <div class="large-container">
        <div class="row">
          {% for product in predictive_search.resources.products %}
            <div class="col-lg-3 col-md-6 col-sm-6 col-6">
              {%- render 'pesto-product-tiny-three' -%, product: product -%}
            </div>
          {% endfor %}
          <div
            id="predictive-search-option-search-keywords"
            class="predictive-search__list-item col-lg-12"
            role="option"
          >
            <button
              class="predictive-search__item predictive-search__item--term link link--text h5 animate-arrow"
              tabindex="-1"
            >
              {{ 'templates.search.search_for' | t: terms: predictive_search.terms }}
            </button>
          </div>
        </div>
      </div>
    </div>
    <div class="predictive-search__loading-state" aria-hidden="true">
      <svg
        aria-hidden="true"
        focusable="false"
        role="presentation"
        class="spinner"
        viewBox="0 0 66 66"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
      </svg>
    </div>
  </div>
{%- endif -%}
