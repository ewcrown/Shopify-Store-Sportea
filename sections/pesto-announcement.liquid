
{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}


{%- style -%}

{%- for block in section.blocks -%}
{%- case block.type -%}
{%- when 'announcement' -%}
.block-{{ block.id }}-{{ block.settings.content_alignment }} .announcement-bar-link{
/* justify-content: {{ block.settings.content_alignment }};
  flex-wrap:wrap; */
  display:inline-block !important;
}
  .pesto-announcement-bar {
    text-align:center;
  }
{%- endcase -%}
{%- endfor -%}

{%- endstyle -%}



<div class="pesto-announcement-bar-custom-area color-{{ section.settings.color_scheme }}">

  {%- if section.settings.enable_country_selector or section.settings.enable_language_selector or
  section.settings.show_social_icon_announce -%}
  <div class="large-container">
    <div class="row align-items-center">    
      <div class="col-lg-6 col-sm-12">    
        <div class="left-announce-inner">
            <announcement-bar class="announce-slider">
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when 'announcement' -%}
                    {% assign block_count = block_count | plus: 1 %}
                      <div class="slide" {{ block.shopify_attributes }}>
                        <div class="pesto-announcement-bar block-{{ block.id  }}-{{ block.settings.content_alignment }}">
                          {%- if block.settings.text != blank -%}
                            {%- if block.settings.link != blank -%}

                              <a href="{{ block.settings.link }}" {% if block.settings.link_open_in_new_tab==true %} target="_blank"
                                {%- endif -%}
                                class="announcement-bar-link announcement-bar-link-active {% if block.settings.announce_btn_text != blank %}underline-none{% endif %}">
                                {%- if block.settings.announcement_top_svg != blank -%}
                                {{ block.settings.announcement_top_svg }}
                                {%- endif -%}
                                {%- if block.settings.announcement_top_img != blank -%}
                                <img data-src="{{ block.settings.announcement_top_img | img_url: 'master' }}" loading="lazy"
                                  class="lazyload" width="{{ block.settings.announcement_top_img.width }}"
                                  height="{{ block.settings.announcement_top_img.height }}"
                                  alt="{{ block.settings.announcement_top_img.alt | escape }}">
                                {%- endif -%}

                                {{ block.settings.text }}

                                {% if block.settings.announce_btn_text != blank %}
                                <span class="announce-btn">{{ block.settings.announce_btn_text }} <svg width="10" height="10"
                                    viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path
                                      d="M0.625 9.375L9.375 0.625L0.625 9.375ZM9.375 0.625H2.8125H9.375ZM9.375 0.625V7.1875V0.625Z"
                                      fill="currentColor" />
                                    <path d="M0.625 9.375L9.375 0.625M9.375 0.625H2.8125M9.375 0.625V7.1875" stroke="currentColor"
                                      stroke-width="0.875" stroke-linecap="round" stroke-linejoin="round" />
                                  </svg>
                                </span>
                                {% endif %}

                              </a>

                            {%- else -%}
                              <p class="announcement-bar-link">
                                {%- if block.settings.announcement_top_svg != blank -%}
                                {{ block.settings.announcement_top_svg }}
                                {%- endif -%}
                                {%- if block.settings.announcement_top_img != blank -%}
                                <img data-src="{{ block.settings.announcement_top_img | img_url: 'master' }}" loading="lazy"
                                  class="lazyload" width="{{ block.settings.announcement_top_img.width }}"
                                  height="{{ block.settings.announcement_top_img.height }}"
                                  alt="{{ block.settings.announcement_top_img.alt | escape }}">
                                {%- endif -%}
                                {{ block.settings.text }}
                                {% if block.settings.announce_btn_text != blank %}
                                <a class="announce-btn" href="{{ block.settings.link }}">{{
                                  block.settings.announce_btn_text }}
                                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none"
                                    xmlns="http://www.w3.org/2000/svg">
                                    <path
                                      d="M0.625 9.375L9.375 0.625L0.625 9.375ZM9.375 0.625H2.8125H9.375ZM9.375 0.625V7.1875V0.625Z"
                                      fill="currentColor" />
                                    <path d="M0.625 9.375L9.375 0.625M9.375 0.625H2.8125M9.375 0.625V7.1875" stroke="currentColor"
                                      stroke-width="0.875" stroke-linecap="round" stroke-linejoin="round" />
                                  </svg>
                                </a>
                                {% endif %}
                              </p>
                            {%- endif -%}
                          {%- endif -%}
                        </div>
                      </div>
                  {%- endcase -%}
              {%- endfor -%}
            </announcement-bar>
        </div>
      </div>
      <div class="col-lg-6 d-lg-block d-none">
        <div class="right-announce-inner">
          {% if section.settings.enable_country_selector or section.settings.enable_language_selector %}
          {% render 'loca-form-footer' %}
          {% endif %}
          {% if section.settings.show_social_icon_announce %}
          <ul aria-label="{{ 'general.social_lvl_list' | t }}" class="social-links list list-social list-unstyled" role="list">
            {%- if settings.social_twitter_link != blank -%}
            <li class="list-social__item">
              <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_twitter_link }}" class="list-social__link link">
                {%- render 'icon-twitter' -%}
                <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
              </a>
            </li>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
            <li class="list-social__item">
              <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_facebook_link }}" class="list-social__link link">
                {%- render 'icon-facebook' -%}
                <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
              </a>
            </li>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
            <li class="list-social__item">
              <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                {%- render 'icon-pinterest' -%}
                <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
              </a>
            </li>
            {%- endif -%}
            {%- if settings.social_instagram_link != blank -%}
            <li class="list-social__item">
              <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_instagram_link }}" class="list-social__link link">
                {%- render 'icon-instagram' -%}
                <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
              </a>
            </li>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
            <li class="list-social__item">
              <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_tiktok_link }}" class="list-social__link link">
                {%- render 'icon-tiktok' -%}
                <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
              </a>
            </li>
            {%- endif -%}
            {%- if settings.social_tumblr_link != blank -%}
            <li class="list-social__item">
              <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_tumblr_link }}" class="list-social__link link">
                {%- render 'icon-tumblr' -%}
                <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
              </a>
            </li>
            {%- endif -%}
            {%- if settings.social_snapchat_link != blank -%}
            <li class="list-social__item">
              <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                {%- render 'icon-snapchat' -%}
                <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
              </a>
            </li>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
            <li class="list-social__item">
              <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_youtube_link }}" class="list-social__link link">
                {%- render 'icon-youtube' -%}
                <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
              </a>
            </li>
            {%- endif -%}
            {%- if settings.social_vimeo_link != blank -%}
            <li class="list-social__item">
              <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_vimeo_link }}" class="list-social__link link">
                {%- render 'icon-vimeo' -%}
                <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
              </a>
            </li>
            {%- endif -%}
          </ul>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {%- else -%}
  <div class="large-container">
    <div class="row">
      <div class="col-lg-12">
        <announcement-bar class="announce-slider " initial-index="1" >
                  {%- for block in section.blocks -%}
                    {%- case block.type -%}
                    {%- when 'announcement' -%}
                      {% assign block_count = block_count | plus: 1 %}
                      <div class="slide" {{ block.shopify_attributes }}>
                        <div class="pesto-announcement-bar block-{{ block.id  }}-{{ block.settings.content_alignment }}">
                          {%- if block.settings.text != blank -%}
                          {%- if block.settings.link != blank -%}
    
                          <a href="{{ block.settings.link }}" {% if block.settings.link_open_in_new_tab==true %} target="_blank"
                            {%- endif -%}
                            class="announcement-bar-link announcement-bar-link-active {% if block.settings.announce_btn_text != blank %}underline-none{% endif %}">
                            {%- if block.settings.announcement_top_svg != blank -%}
                            {{ block.settings.announcement_top_svg }}
                            {%- endif -%}
                            {%- if block.settings.announcement_top_img != blank -%}
                            <img data-src="{{ block.settings.announcement_top_img | img_url: 'master' }}" loading="lazy"
                              class="lazyload" width="{{ block.settings.announcement_top_img.width }}"
                              height="{{ block.settings.announcement_top_img.height }}"
                              alt="{{ block.settings.announcement_top_img.alt | escape }}">
                            {%- endif -%}
    
                            {{ block.settings.text }}
                            {% if block.settings.announce_btn_text != blank %}
                            <span class="announce-btn">{{ block.settings.announce_btn_text }} <svg width="10" height="10"
                                viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path
                                  d="M0.625 9.375L9.375 0.625L0.625 9.375ZM9.375 0.625H2.8125H9.375ZM9.375 0.625V7.1875V0.625Z"
                                  fill="currentColor" />
                                <path d="M0.625 9.375L9.375 0.625M9.375 0.625H2.8125M9.375 0.625V7.1875" stroke="currentColor"
                                  stroke-width="0.875" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </span>
                            {% endif %}
    
                          </a>
    
                          {%- else -%}
                          <p class="announcement-bar-link">
                            {%- if block.settings.announcement_top_svg != blank -%}
                            {{ block.settings.announcement_top_svg }}
                            {%- endif -%}
                            {%- if block.settings.announcement_top_img != blank -%}
                            <img data-src="{{ block.settings.announcement_top_img | img_url: 'master' }}" loading="lazy"
                              class="lazyload" width="{{ block.settings.announcement_top_img.width }}"
                              height="{{ block.settings.announcement_top_img.height }}"
                              alt="{{ block.settings.announcement_top_img.alt | escape }}">
                            {%- endif -%}
                            {{ block.settings.text }}
                            {% if block.settings.announce_btn_text != blank %}
                            <a class="announce-btn" href="{{ block.settings.link }}">{{
                              block.settings.announce_btn_text }} <svg width="10" height="10" viewBox="0 0 10 10" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path
                                  d="M0.625 9.375L9.375 0.625L0.625 9.375ZM9.375 0.625H2.8125H9.375ZM9.375 0.625V7.1875V0.625Z"
                                  fill="currentColor" />
                                <path d="M0.625 9.375L9.375 0.625M9.375 0.625H2.8125M9.375 0.625V7.1875" stroke="currentColor"
                                  stroke-width="0.875" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </a>
                            {% endif %}
                          </p>
                          {%- endif -%}
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endcase -%}
                  {%- endfor -%}
        </announcement-bar>
      </div>
    </div>
  </div>
  {% endif %}
</div>


{% schema %}
{
"name": "Announcement bar",
"max_blocks": 2,
"settings": [
{
  "type": "color_scheme",
  "id": "color_scheme",
  "default": "background-3",
  "label": "Color scheme"
},
{
  "type": "header",
  "content": "Country/region selector",
  "info": "To add a country/region, go to your [market settings.](/admin/settings/markets)"
},
{
  "type": "checkbox",
  "id": "enable_country_selector",
  "default": false,
  "label": "Enable country/region selector"
},
{
  "type": "checkbox",
  "id": "enable_country_selector_label",
  "default": false,
  "label": "Enable country/region selector label"
},
{
  "type": "header",
  "content": "Language selector",
  "info": "To add a language, go to your [language settings.](/admin/settings/languages)"
},
{
  "type": "checkbox",
  "id": "enable_language_selector",
  "default": false,
  "label": "Enable language selectors"
},
{
  "type": "checkbox",
  "id": "enable_language_selector_label",
  "default": false,
  "label": "Enable language selector label"
},
{
  "type": "header",
  "content": "Social media icons"
},
{
  "type": "checkbox",
  "id": "show_social_icon_announce",
  "default": false,
  "label": "Show social media icons"
}
],
"blocks": [
  {
  "type": "announcement",
  "name": "Announcement",
  "settings": [
  {
  "type": "textarea",
  "id": "announcement_top_svg",
  "label": "Icon",
  "info": "Paste your icon's SVG image code"
  },
  {
  "type": "image_picker",
  "id": "announcement_top_img",
  "label": "Image"
  },
  {
  "type": "text",
  "id": "text",
  "default": "Announcement text here",
  "label": "Text"
  },
  {
  "type": "text",
  "id": "announce_btn_text",
  "label": "Highlight text"
  },
  {
  "type": "url",
  "id": "link",
  "label": "Link"
  },
  {
  "type": "checkbox",
  "id": "link_open_in_new_tab",
  "default": false,
  "label": "Link open in a new tab"
  },
  {
  "type": "select",
  "id": "content_alignment",
  "options": [
  {
  "value": "flex-start",
  "label": "Left"
  },
  {
  "value": "center",
  "label": "Center"
  },
  {
  "value": "flex-end",
  "label": "Right"
  }
  ],
  "default": "center",
  "label": "Content alignment"
  }
  ]
  }
  ],
  "default": {
    "blocks": [
      {
      "type": "announcement"
      }
    ]
  }
}
{% endschema %}