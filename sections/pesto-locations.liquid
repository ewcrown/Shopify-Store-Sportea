<link rel="stylesheet" href="{{ 'ui-page-title.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'ui-page-title.css' | asset_url | stylesheet_tag }}</noscript>
<link rel="stylesheet" href="{{ 'ui-location-section.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'ui-location-section.css' | asset_url | stylesheet_tag }}</noscript>

{% assign col_dextop = section.settings.col_settings %}

{% if col_dextop == 1 %}
    {% assign col_dextop_val = '12' %}
{% elsif col_dextop == 2 %}
    {% assign col_dextop_val = '6' %}
{% elsif col_dextop == 3 %}
    {% assign col_dextop_val = '4' %}
{% elsif col_dextop == 4 %}
    {% assign col_dextop_val = '3' %}
{% endif %}

{%- style -%}
    #shopify-section-{{section.id}} .location-section {
        position: relative;
    }
    #shopify-section-{{section.id}} .placeholder-svg-locations-bg {
        margin: 0 auto;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 150px;
        border: 0;
        border-radius: 0;
        background: transparent;
    }

    {%- if section.settings.pesto_container_bottom_top != blank -%}
        #shopify-section-{{section.id}} .location-section .inner-container {
            padding-bottom: {{ section.settings.pesto_container_bottom_top }}px  !important;
        }
    {%- endif -%}

    {%- if section.settings.pesto_section_padding_top != blank -%}
        #shopify-section-{{section.id}} .location-section,
        #shopify-section-{{section.id}} .page-title.shop-page{
            padding-top: {{ section.settings.pesto_section_padding_top }}px  !important;
        }
    {%- endif -%}
    {%- if section.settings.pesto_section_padding_bottom != blank -%}
        #shopify-section-{{section.id}} .location-section,
        #shopify-section-{{section.id}} .page-title.shop-page{
            padding-bottom: {{ section.settings.pesto_section_padding_bottom }}px !important;
        }
    {%- endif -%}
{%- endstyle -%}

<div id="{{ section.id }}" class="location-section color-{{ section.settings.color_scheme }} show-the-border-{{section.settings.show_border_show_hide}}">
    <div class="large-container">
        <div class="inner-container">
            <div class="sec-title centred">
                <h2>{{ section.settings.sections_title }}</h2>
            </div>
            <div class="row clearfix">
                
                {% for block in section.blocks %}
                    {% case block.type %}
                        {% when 'locations_items' %}
                            <div class="col-lg-{{col_dextop_val}} col-md-6 col-sm-12 location-block">
                                <div class="location-block-one wow animated" data-wow-delay="00ms" data-wow-duration="1500ms">
                                    <div class="inner-box show-shadow-{{ section.settings.pesto_shadow_show_hide }}">
                                        <figure class="image-box">
                                            {%- if block.settings.images != blank -%}
                                                <img
                                                data-src="{{ block.settings.images | img_url: 'master' }}"
                                                    loading="lazy"  class="lazyload"
                                                    width="{{ block.settings.images.width }}"
                                                    height="{{ block.settings.images.height }}"
                                                    alt="{{ block.settings.images.alt | escape }}"
                                                >
                                            {%- else -%}
                                                {{ 'image' | placeholder_svg_tag: 'placeholder-svg-locations' }}
                                            {%- endif -%}
                                        </figure>
                                        {%- if block.settings.title != blank or block.settings.address != blank or block.settings.phone != blank or block.settings.time != blank -%}
                                            <div class="lower-content">
                                                {%- if block.settings.title != blank -%}
                                                    <h2>
                                                        {%- if block.settings.url != blank -%}
                                                            <a href="{{ block.settings.url }}">{{ block.settings.title }}</a>
                                                        {%- else -%}
                                                            {{ block.settings.title }}
                                                        {%- endif -%}
                                                    </h2>
                                                {%- endif -%}

                                                {% if block.settings.pesto_location_sub_heading != blank %}
                                                    <p>{{block.settings.pesto_location_sub_heading}}</p>
                                                {% endif %}

                                                {%- if block.settings.address != blank or block.settings.phone != blank or block.settings.time != blank -%}
                                                    <ul class="info clearfix">
                                                        {%- if block.settings.address != blank -%}
                                                            <li>
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt" viewBox="0 0 16 16">
                                                                    <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A31.493 31.493 0 0 1 8 14.58a31.481 31.481 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94zM8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10z"/>
                                                                    <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                                                </svg>
                                                                <p>{{ block.settings.address }}</p>
                                                            </li>
                                                        {%- endif -%}
                                                        {%- if block.settings.phone != blank -%}
                                                            <li>
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone" viewBox="0 0 16 16">
                                                                    <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
                                                                </svg>
                                                                <p><a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a></p>
                                                            </li>
                                                        {%- endif -%}
                                                        {%- if block.settings.time != blank -%}
                                                            <li>
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clock" viewBox="0 0 16 16">
                                                                    <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                                                                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                                                                </svg>
                                                                <p>{{ block.settings.time }}</p>
                                                            </li>
                                                        {%- endif -%}
                                                    </ul>
                                                {%- endif -%}
                                            </div>
                                        {%- endif -%}
                                    </div>
                                </div>
                            </div>
                    {% endcase %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% schema %}
    {
        "name": "Locations",
        "tag": "section",
        "class": "locations-area",
        "settings": [
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "default": "background-4",
                "label": "Color scheme"
            },
            {
                "type": "range",
                "id": "col_settings",
                "min": 1,
                "max": 4,
                "step": 1,
                "label": "Columns",
                "default": 3
            },
            {
                "type": "text",
                "id": "sections_title",
                "label": "Heading",
                "default": "Heading"
            },
            {
              "type": "checkbox",
              "id": "pesto_shadow_show_hide",
              "default": true,
              "label": "Show shadow"
            },
            {
              "type": "checkbox",
              "id": "show_border_show_hide",
              "default": false,
              "label": "Show border bottom"
            },
            {
                "type": "header",
                "content": "Container padding"
            },
            {
                "type": "range",
                "id": "pesto_container_bottom_top",
                "min": 0,
                "max": 200,
                "step": 10,
                "unit": "px",
                "label": "t:sections.all.padding.padding_bottom",
                "default": 0
            },
            {
                "type": "header",
                "content": "Section padding"
            },
            {
                "type": "range",
                "id": "pesto_section_padding_top",
                "min": 0,
                "max": 200,
                "step": 10,
                "unit": "px",
                "label": "t:sections.all.padding.padding_top",
                "default": 150
            },
            {
                "type": "range",
                "id": "pesto_section_padding_bottom",
                "min": 0,
                "max": 200,
                "step": 10,
                "unit": "px",
                "label": "t:sections.all.padding.padding_bottom",
                "default": 150
            }
        ],
        "blocks": [
            {
                "type": "@app"
            },
            {
                "name": "Items",
                "type": "locations_items",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "images",
                        "label": "Image"
                    },
                    {
                        "type": "text",
                        "id": "title",
                        "label": "Heading",
                        "default": "Block heading"
                    },
                    {
                        "type": "url",
                        "id": "url",
                        "label": "Heading link"
                    },
                    {
                        "type": "text",
                        "id": "pesto_location_sub_heading",
                        "label": "Sub heading",
                        "default": "Ethan embarked on his culinary adventure during the early stages of his life, exploring."
                    },
                    {
                        "type": "text",
                        "id": "address",
                        "label": "Address",
                        "default": "Address of your store"
                    },
                    {
                        "type": "text",
                        "id": "phone",
                        "label": "Phone",
                        "default": "+123456"
                    },
                    {
                        "type": "text",
                        "id": "time",
                        "label": "Time",
                        "default": "Add your store time"
                    }
                ]
            }
        ],
        "presets": [
            {
                "name": "Locations",
                "blocks": [
                    {
                        "type": "locations_items"
                    },
                    {
                        "type": "locations_items"
                    },
                    {
                        "type": "locations_items"
                    }
                ]
            }
        ]
    }
{% endschema %}