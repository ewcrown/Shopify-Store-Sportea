{{ 'ui-collection-single.css' | asset_url | stylesheet_tag }}
{%- style -%}
  {%- if section.settings.pesto_section_padding_top != blank -%}
    .pesto-collection-area{
        padding-top: {{ section.settings.pesto_section_padding_top }}px;
    }
  {%- endif -%}
  {%- if section.settings.pesto_section_padding_bottom != blank -%}
    .pesto-collection-area{
        padding-bottom: {{ section.settings.pesto_section_padding_bottom }}px;
    }
  {%- endif -%}
{%- endstyle -%}

{% assign col_dextop = section.settings.col_settings %}
{% if col_dextop == 1 %}
    {% assign col_dextop_val = '12' %}
{% elsif col_dextop == 2 %}
    {% assign col_dextop_val = '6' %}
{% elsif col_dextop == 3 %}
    {% assign col_dextop_val = '4' %}
{% elsif col_dextop == 4 %}
    {% assign col_dextop_val = '3' %}
{% endif  %}

<div class="page-width pesto-collection-area pesto-collection-only-area pesto-collection-only-type-{{ section.settings.collection_card_type }} color-{{ section.settings.color_scheme }} title-underline-{{ section.settings.collection_list_underline }}">
  <div class="center-page-width">
    <h1 class="title title--primary">{{ section.settings.title | escape }}</h1>
    {%- liquid
      case section.settings.sort
        when 'products_high' or 'products_low'
          assign collections = collections | sort: 'all_products_count'
        when 'date' or 'date_reversed'
          assign collections = collections | sort: 'published_at'
      endcase
      if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
        assign collections = collections | reverse
      endif
    -%}

    {%- paginate collections by section.settings.blog_list_item -%}
      <ul class="collection-list grid grid--1-col grid--3-col-tablet row" aria-label="{{ 'general.collections_list' | t }}" role="list">
        {%- for collection in collections -%}
          <li class="collection-list__item grid__item col-lg-{{col_dextop_val}} col-md-6 col-sm-12 shop-block pesto-collection-list">{% render 'card-collection', card_collection: collection, media_aspect_ratio: 'adapt', columns: 3 %}</li>
        {%- endfor -%}
      </ul>
      <div class="col-md-12">
        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate, anchor: '' %}
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "class": "section",
  "settings": [
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "background-1",
        "label": "Color scheme"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.main-list-collections.settings.title.label",
      "default": "heading"
    },
    {
      "type": "select",
      "id": "sort",
      "options": [
        {
          "value": "alphabetical",
          "label": "t:sections.main-list-collections.settings.sort.options__1.label"
        },
        {
          "value": "alphabetical_reversed",
          "label": "t:sections.main-list-collections.settings.sort.options__2.label"
        },
        {
          "value": "date_reversed",
          "label": "t:sections.main-list-collections.settings.sort.options__3.label"
        },
        {
          "value": "date",
          "label": "t:sections.main-list-collections.settings.sort.options__4.label"
        },
        {
          "value": "products_high",
          "label": "t:sections.main-list-collections.settings.sort.options__5.label"
        },
        {
          "value": "products_low",
          "label": "t:sections.main-list-collections.settings.sort.options__6.label"
        }
      ],
      "default": "alphabetical",
      "label": "t:sections.main-list-collections.settings.sort.label"
    },
    {
      "label": "Card type",
      "id": "collection_card_type",
      "type": "select",      
      "default": "card",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "card",
          "label": "Card"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          {
              "value": "left",
              "label": "Left"
          },
          {
              "value": "center",
              "label": "Center"
          },
          {
              "value": "right",
              "label": "Right"
          }
      ],
      "default": "center",
      "label": "Text alignment"
    },
    {
      "type": "checkbox",
      "id": "collection_list_count",
      "default": false,
      "label": "Show products count"
    },
    {
      "type": "checkbox",
      "id": "collection_list_underline",
      "default": false,
      "label": "Show products title underline"
    },
    {
        "type": "range", 
        "id": "col_settings",
        "min": 1,
        "max": 4,
        "step": 1,
        "label": "Columns",
        "default": 4
    },
    {
        "type": "range",
        "id": "blog_list_item",
        "min": 1,
        "max": 10,
        "step": 1,
        "label": "Collections per page",
        "default": 4
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
        "type": "range",
        "id": "pesto_section_padding_top",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 150
    },
    {
        "type": "range",
        "id": "pesto_section_padding_bottom",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 150
    }
  ]
}
{% endschema %}