{% schema %}
{
  "name": "<> Product Highlight",
  "tag": "section",
  "blocks": [
    {
      "type": "ingredient",
      "name": "Herbal Component",
      "settings": [
        {
          "type": "text",
          "id": "title1",
          "label": "Herbal Component Name",
          "default": "Premium Black Tea"
        },
        {
          "type": "text",
          "id": "title2",
          "label": "Benefits",
          "default": "Alertness, Focus, Concentration"
        },
        {
          "type": "text",
          "id": "title3",
          "label": "Benefits",
          "default": "Alertness, Focus, Concentration"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image1",
      "label": "Image1"
    },
    {
      "type": "image_picker",
      "id": "image2",
      "label": "Image2"
    },
    {
      "type": "header",
      "content": "Table"
    },
    {
      "type": "checkbox",
      "id": "show_table",
      "label": "Show Table",
      "default": false
    },
    {
      "type": "text",
      "id": "table1",
      "label": "Table Heading1",
      "default": "Herbal Component"
    },
    {
      "type": "text",
      "id": "table2",
      "label": "Table Heading2",
      "default": "Herbal Component"
    },
    {
      "type": "text",
      "id": "table3",
      "label": "Table Heading3",
      "default": "Herbal Component"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background Color",
      "default": "#fff"
    },
    {
      "type": "number",
      "id": "list_size",
      "label": "List Font Size",
      "default": 24
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#00A4FF"
    },
    {
      "type": "number",
      "id": "link_weight",
      "label": "Link Weight",
      "default": 500
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Iced SPORTea® Premium Cold Brew Iced Tea for Energy & Hydration"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Refreshing cold brew iced tea with ice and lemon - Iced SPORTea®"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover the ultimate cold brew iced tea designed for active lifestyles. Iced SPORTea® delivers refreshing hydration and natural energy without the sugar, calories, or artificial ingredients found in other iced tea options.</p>"
    },
    {
      "type": "richtext",
      "id": "after_images_description",
      "label": "After Images Description"
    },
    {
      "type": "richtext",
      "id": "after_description",
      "label": "After Table Description"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "<> Product Highlight",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<style>
  .product-highlight-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    padding:100px 0;
    gap:60px;
  }
  .product-highlight-text {
    flex: 1;
  }

  .product-highlight h2 {
    font-family: Arial;
    font-size: 48px;
    font-style: normal;
    font-weight: 700;
    line-height: 120%; /* 57.6px */
    margin-bottom:30px;
  }

  .product-highlight h3 {
font-family: Arial;
font-size: 24px;
font-style: normal;
font-weight: 700;
line-height: 150%; /* 36px */
margin-bottom:30px;
  }

  .product-highlight ol li {
    font-family: Arial;
    font-style: normal;
    font-weight: 400;
    line-height: 150%; /* 30px */
  }
  .product-highlight ul li {
    list-style:disc;
font-family: Arial;
font-style: normal;
font-weight: 400;
line-height: 150%; /* 36px */
  }
  .product-highlight h4 {
font-family: Arial;
font-size: 36px;
font-style: normal;
font-weight: 700;
line-height: 150%; /* 54px */
    margin-bottom:30px;
  }
  .product-highlight ul {
    padding-left:20px
  }
  

  .product-highlight p a {
    color:#2E8FFF;
    font-weight:600;
  }
  .product-highlight p a:hover{
    color:#dc222a !important;
  }
  .product-highlight p a {
    text-decoration:underline;
  }
  .product-highlight p {
    font-family: Arial;
    font-size: 24px;
    font-style: normal;
    font-weight: 400;
    line-height: 150%; /* 36px */
    margin-bottom: 30px;
  }

  .product-highlight-wrap .btn-box a {
    background-color: rgb(220,35,42);
    color: #fff;
    max-width: 232px;
}

  .product-highlight-image {
    flex: 1;
    text-align: center;
  }

  .product-highlight-image img {
    max-width: 100%;
    border-radius: 10px;
  }


  .product-highlight-{{ section.id }} {
    background: {{  section.settings.background }};
  }
  .product-highlight-{{ section.id }}  .product-highlight-wrap ol li,
  .product-highlight-{{ section.id }}  .product-highlight-wrap ul li {
    font-size: {{ section.settings.list_size }}px;
  }

  .product-highlight-{{ section.id }} .product-highlight-wrap h4,
  .product-highlight-{{ section.id }} .product-highlight-wrap h3,
  .product-highlight-{{ section.id }} .product-highlight-wrap h2,
  .product-highlight-{{ section.id }} .product-highlight-wrap ul li,
  .product-highlight-{{ section.id }} .product-highlight-wrap ol li,
  .product-highlight-{{ section.id }} .product-highlight-wrap p {
    color: {{ section.settings.text_color }};
  }
  .product-highlight-{{ section.id }} p a {
    color: {{ section.settings.link_color }};
    font-weight:{{ section.settings.link_weight }};
  }
  
  .product-highlight-table {
    margin-bottom:40px;
  }

  .product-highlight-images {
  margin-bottom:30px;
  display:grid;
  gap:20px
}
.herbal-table {
  display: flex;
  flex-direction: column;
  border-radius: 8px;
  overflow: hidden;
}

.herbal-table-header {
  display: flex;
  font-weight: bold;
  background-color: black;
  color: white;
  border-radius: 20px 20px 0 0;
}

.herbal-table-header .herbal-table-cell{
  border:1px solid transparent;
  color:#fff;
  height:auto;
  font-weight:600;
  padding: 17px 13px;
}

.herbal-table-row {
  display: flex;
  background-color: white;
  border-top: 1px solid #ddd;
}

.herbal-table-cell {
  flex: 1;
  padding: 9px 13px;
  border-right: 1px solid #ddd;
  height:84px;
  color: #000;
font-family: Arial;
font-size: 23.344px;
font-style: normal;
font-weight: 400;
line-height: normal;
}

.herbal-table-cell:last-child {
  border-right: none;
}


.herbal-table-row:last-child {
  border-radius: 0 0 20px 20px;
}


  @media (max-width: 768px) {
    .product-highlight-wrap {
      padding: 30px 0;
      gap: 30px;
      flex-direction: column;
    }
    .product-highlight h2 {

      font-size: 30px;
      margin-bottom: 10px !important;
    }
    .product-highlight h4 {
      font-size: 26px !important;
      line-height:120%;
      margin-bottom: 10px !important;
  }
    .product-highlight h3 {
      font-size: 20px;
   }
   .product-highlight li,
   .product-highlight p {
      font-size: 16px !important;
    }
    .product-highlight table th, .product-highlight table td {
      padding: 5px;
      font-size: 14px;
      margin-bottom:10px !important;
    }

    .herbal-table-cell {
      padding: 14px !important;
      height: auto !important;
      font-size: 16px !important;
    }
  }
  
</style>

<section class="product-highlight product-highlight-{{ section.id }}">
  <div class="large-container">
    <div class="product-highlight-wrap">
      <div class="product-highlight-text">
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <h3>{{ section.settings.subheading }}</h3>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="product-highlight-description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.image1 != blank and section.settings.image1 != blank %}
        <div class="product-highlight-images">
          {% if section.settings.image1 != blank %}
            <img src="{{ section.settings.image1 | img_url: '600x' }}" alt="{{ section.settings.heading }}">
          {% endif %}
          {% if section.settings.image1 != blank %}
            <img src="{{ section.settings.image2 | img_url: '600x' }}" alt="{{ section.settings.heading }}">
          {% endif %}
        </div>
        {% endif %}

        {% if section.settings.after_images_description != blank %}
          <div class="product-highlight-description">
            {{ section.settings.after_images_description }}
          </div>
        {% endif %}

        {% if section.settings.show_table != blank %}
        <div class="product-highlight-table">
          <div class="herbal-table">
            <div class="herbal-table-header">
              {% if section.settings.table1 != blank %}
                <div class="herbal-table-cell">{{ section.settings.table1 }}</div>
              {% endif %}
              {% if section.settings.table2 != blank %}
                <div class="herbal-table-cell">{{ section.settings.table2 }}</div>
              {% endif %}
              {% if section.settings.table3 != blank %}
                <div class="herbal-table-cell">{{ section.settings.table3 }}</div>
              {% endif %}
            </div>
          
            {% for block in section.blocks %}
              <div class="herbal-table-row">
                {% if section.settings.table1 != blank %}
                  <div class="herbal-table-cell">{{ block.settings.title1 }}</div>
                {% endif %}  
                {% if section.settings.table2 != blank %}
                  <div class="herbal-table-cell">{{ block.settings.title2 }}</div>
                {% endif %}
                {% if section.settings.table3 != blank %}
                  <div class="herbal-table-cell">{{ block.settings.title3 }}</div>
                {% endif %}
              </div>
            {% endfor %}
          </div>

        </div>
      {% endif %}
      {% if section.settings.after_description != blank %}
        <div class="product-highlight-description ">
          {{ section.settings.after_description }}
        </div>
      {% endif %}

        {% if section.settings.button_link != blank %}
          <div class="btn-box">
            <a href="{{section.settings.button_link}}" class="theme-btn btn-two" aria-label="Shop Now" tabindex="0">{{ section.settings.button_text }}<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="#ffffff" height="800px" width="800px" version="1.1" id="Layer_1" viewBox="0 0 330 330" xml:space="preserve" role="presentation">
              <path id="XMLID_27_" d="M15,180h263.787l-49.394,49.394c-5.858,5.857-5.858,15.355,0,21.213C232.322,253.535,236.161,255,240,255  s7.678-1.465,10.606-4.394l75-75c5.858-5.857,5.858-15.355,0-21.213l-75-75c-5.857-5.857-15.355-5.857-21.213,0  c-5.858,5.857-5.858,15.355,0,21.213L278.787,150H15c-8.284,0-15,6.716-15,15S6.716,180,15,180z"></path>
              </svg>
            </a>
          </div>
        {% endif %}
      </div>
      {% if section.settings.image %}
        <div class="product-highlight-image">
          <img src="{{ section.settings.image | img_url: '600x' }}" alt="{{ section.settings.heading }}">
        </div>
      {% endif %}
    </div>
  </div>
</section>
