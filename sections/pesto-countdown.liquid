<link rel="stylesheet" href="{{ 'ui-countdown-section.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'ui-countdown-section.css' | asset_url | stylesheet_tag }}</noscript>
{%- style -%}
    {%- if section.settings.pesto_section_padding_top != blank -%}
    #shopify-section-{{section.id}} .pesto-countdown-section{
            padding-top: {{ section.settings.pesto_section_padding_top }}px;
            padding-bottom: {{ section.settings.pesto_section_padding_bottom }}px;
        }
        @media(max-width: 991px){
            #shopify-section-{{section.id}} .pesto-countdown-section{
            padding-top: {{ section.settings.pesto_section_padding_top_mobile }}px;
            padding-bottom: {{ section.settings.pesto_section_padding_bottom_mobile }}px;
        }
        }
    {%- endif -%}
    #shopify-section-{{section.id}} .pesto-countdown-section .countdown-bg-media:after{
        opacity: {{ section.settings.pesto_countdown_bg_opacity | divided_by: 100.0 }};
    }
{%- endstyle -%}

<count-down class="count-element-area">
    <div class="pesto-countdown-section  color-{{ section.settings.color_scheme }} layout-direction-{{ section.settings.pesto_countdown_layout }}">
    
        {% if section.settings.pesto_countdown_bg_img != blank %}
            <div class="countdown-bg-media">
                <img
                    data-src="{{ section.settings.pesto_countdown_bg_img | img_url: 'master' }}"
                    loading="lazy"  class="lazyload"
                    width="{{ section.settings.pesto_countdown_bg_img.width }}"
                    height="{{ section.settings.pesto_countdown_bg_img.height }}"
                    alt="{{ section.settings.pesto_countdown_bg_img.alt | escape }}"
                />
            </div>
        {% endif %}

        <div class="large-container">
            <div class="countdown-section-inner">
                {% for block in section.blocks %}
                    {%- case block.type -%}
                        {%- when 'heading_text' -%}
                            <div class="countdown-text">
                                <h3 class="heading-size-{{ block.settings.pesto_heading_text_size }}">{{ block.settings.heading }}</h3>
                                <p>{{block.settings.description}}</p>
                            </div>
                        {%- when 'timer' -%} 
                            <div
                                class="countdown-timer" 
                                data-year="{{ block.settings.select_year }}"
                                data-month="{{ block.settings.select_month }}"
                                data-day="{{ block.settings.select_day }}"
                                data-hour="{{ block.settings.select_hour }}"
                                data-min="{{ block.settings.select_min }}"
                            >
                                <div data-time-message="{{ block.settings.timer_end_message }}" class="timer-end-message">{{ block.settings.timer_end_message }}</div>
                                
                                <div data-timer-visibility="false" class="countdown-timer-inner show-border-{{ block.settings.pesto_countdown_border }} timer-text-size-{{ block.settings.pesto_countdown_timer_size }}">
                                    <div class="timer-block">
                                        <p>{{ 'general.place_day' | t }}</p>
                                        <h3 class="id-days"></h3>
                                    </div>
                                    <span>:</span>
                                    <div class="timer-block">
                                        <p>{{ 'general.place_hrs' | t }}</p>
                                        <h3 class="id-hours"></h3>
                                    </div>
                                    <span>:</span>
                                    <div class="timer-block">
                                        <p>{{ 'general.place_min' | t }}</p>
                                        <h3 class="id-minutes"></h3>
                                    </div>
                                    <span>:</span>
                                    <div class="timer-block">
                                        <p>{{ 'general.place_sec' | t }}</p>
                                        <h3 class="id-seconds"></h3>
                                    </div>
                                </div>
                            </div>
                        {%- when 'button' -%}
                            {%- if block.settings.button_text != blank -%}
                                <div class="countdown-button">
                                    <a class="{{ block.settings.pesto_button_style }}" href="{{ block.settings.button_link }}">{{ block.settings.button_text }}
                                        {% if block.settings.pesto_button_icon == "icon1" %}
                                            {% render "pesto-btn-icon-arrow" %}
                                        {% elsif block.settings.pesto_button_icon == "icon2" %}
                                            {% render 'icon-right-tick' %}
                                        {% elsif block.settings.pesto_button_icon == "icon3" %}
                                            {% render 'icon-leaf' %}
                                        {% elsif block.settings.pesto_button_icon == "icon4" %}
                                            {% render 'icon-chemistry' %}
                                        {% elsif block.settings.pesto_button_icon == "icon5" %}
                                            {% render 'icon-organic' %}
                                        {% endif %}
                                    </a>
                                </div>
                            {%- endif -%}
                    {% endcase %}
                {% endfor %}
            </div>
        </div>
    </div>
</count-down>
