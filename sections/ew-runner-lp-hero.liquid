<section
  id="ew-runner-lp-hero"
  class="ew-runner-lp-hero"
  {% if section.settings.background_image != blank %}
    style="--ew-runner-lp-hero-bg: url('{{ section.settings.background_image | image_url: width: 2400 }}');"
  {% endif %}
>
  <div class="ew-runner-lp-hero__overlay" aria-hidden="true"></div>

  <div class="large-container ew-runner-lp-hero__container">
    <div class="ew-runner-lp-hero__content">
      {%- if section.settings.subtitle != blank -%}
        <p class="ew-runner-lp-hero__badge">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="ew-runner-lp-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="ew-runner-lp-hero__description rte">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="ew-runner-lp-hero__cta-wrap">
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="theme-btn btn-one ew-runner-lp-hero__cta"
          >
            {{ section.settings.button_label | escape }}
          </a>
          {%- if section.settings.button_note != blank -%}
            <p class="ew-runner-lp-hero__cta-note">{{ section.settings.button_note | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ew-runner-lp-hero__reviews">
        {%- if section.settings.reviews_image != blank -%}
          <div class="ew-runner-lp-hero__reviews-image">
            {{
              section.settings.reviews_image
              | image_url: width: 400
              | image_tag:
                class: 'ew-runner-lp-hero__reviews-img',
                loading: 'lazy',
                alt: section.settings.reviews_text
            }}
          </div>
        {%- else -%}
          {%- assign avatar_blocks = section.blocks | where: 'type', 'avatar' -%}
          {%- if avatar_blocks.size > 0 -%}
            <div class="ew-runner-lp-hero__reviews-avatars">
              {%- for block in avatar_blocks -%}
                {%- if block.settings.image != blank -%}
                  <img
                    class="ew-runner-lp-hero__reviews-avatar"
                    src="{{ block.settings.image | image_url: width: 80, height: 80, crop: 'center' }}"
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    {{ block.shopify_attributes }}
                  >
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        <div class="ew-runner-lp-hero__reviews-meta">
          {%- if section.settings.show_stars -%}
            <div class="ew-runner-lp-hero__reviews-stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M9 1.31836L11.3175 6.01086L16.5 6.72711L12.75 10.3521L13.635 15.5109L9 12.9434L4.365 15.5109L5.25 10.3521L1.5 6.72711L6.6825 6.01086L9 1.31836Z" fill="currentColor"/>
                </svg>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if section.settings.reviews_text != blank -%}
            <p class="ew-runner-lp-hero__reviews-text">{{ section.settings.reviews_text | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
      {%- if feature_blocks.size > 0 -%}
        <ul class="ew-runner-lp-hero__features">
          {%- for block in feature_blocks -%}
            <li class="ew-runner-lp-hero__feature" {{ block.shopify_attributes }}>
              <svg class="ew-runner-lp-hero__feature-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.625 7L5.6875 10.0625L11.375 4.375" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Runner LP — Hero",
  "tag": "section",
  "class": "ew-runner-lp-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE RUNNER'S CHOICE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean Fuel for Every Mile – No Sugar, No Crash, No Junk."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A naturally energizing, electrolyte-rich tea that fuels your run and keeps you hydrated — with zero sugar, zero calories, and none of the crash. Loved by runners (and 5,000+ five-star reviewers).</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "GET MY 2-BOX STARTER PACK"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_note",
      "label": "Button bottom text",
      "default": "Free Shipping · First-Time Customer Special"
    },
    {
      "type": "image_picker",
      "id": "reviews_image",
      "label": "Reviews image",
      "info": "Optional. Shows instead of individual avatar blocks."
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_text",
      "label": "Reviews text",
      "default": "5,078 verified 5-star reviews"
    }
  ],
  "blocks": [
    {
      "type": "avatar",
      "name": "Review avatar",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Avatar image"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "No Sugar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Runner LP — Hero",
      "blocks": [
        { "type": "feature", "settings": { "text": "No Sugar" } },
        { "type": "feature", "settings": { "text": "Real Electrolytes" } },
        { "type": "feature", "settings": { "text": "98% Caffeine-Free" } },
        { "type": "feature", "settings": { "text": "Zero Calorie" } }
      ]
    }
  ]
}
{% endschema %}
