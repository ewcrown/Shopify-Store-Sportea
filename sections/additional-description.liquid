
{%- style -%}
  {%- if section.settings.pesto_section_padding_top != blank -%}
      #shopify-section-{{section.id}} .shop-details-single-tab-area {
          padding-top: {{ section.settings.pesto_section_padding_top }}px;
      }
  {%- endif -%}

  {%- if section.settings.pesto_section_padding_bottom != blank -%}
      #shopify-section-{{section.id}} .shop-details-single-tab-area {
          padding-bottom: {{ section.settings.pesto_section_padding_bottom }}px;
      }
  {%- endif -%} 
{%- endstyle -%}

<div id="{{ section.id }}" class="shop-details-single-tab-area color-{{ section.settings.color_scheme }}">
  <div class="large-container">
    <div class="row">
      <div class="col-lg-12">
        <div class="shop-details-single-tab-list">
          <la-tab>
              <div class="la-tab-heading-area">
                {% assign block_count = section.blocks.size %}
                <div class="la-tab-heading-items {% if block_count > 2 %}justify-content-between{% endif %}">
                  {%- for block in section.blocks -%}
                    {%- case block.type -%}
                      {%- when 'description' -%}
                        <button
                          class="la-tab-heading-item {% if forloop.index0 == 0 %}active{% endif %}"
                        >
                          {{ block.settings.heading }}
                        </button>
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              </div>
              <div class="la-tab-content-area">
                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                    {%- when 'description' -%}
                      <div class="la-tab-content-single {% if forloop.index0 == 0 %}active{% endif %}">
                        {% if block.settings.content_rich != blank %}
                          <div class="product-description-content rte-content-area">
                            {{ block.settings.content_rich }} 
                          </div>
                        {% endif %}
                        {% if block.settings.page.content != blank %}
                        <div class="product-description-content rte-content-area">
                            {{ block.settings.page.content }}
                          </div>
                        {% endif %}
                        {% if block.settings.custom_liquid != blank %}
                        <div class="product-description-content rte-content-area">
                            {{ block.settings.custom_liquid }}
                          </div>
                        {% endif %}
                      </div>
                  {%- endcase -%}
                {%- endfor -%}
              </div>
          </la-tab>
        </div>
      </div>
    </div>
  </div>
</div>




{% schema %}
{
  "name": "Additional description",
  "tag": "section",
  "class": "additional-description-section",
  "templates": ["product"],
  "blocks": [
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Heading",
          "label": "Heading",
          "info": "Include a heading that explains the content."
        },
        {
          "type": "richtext",
          "id": "content_rich",
          "label": "Content",
          "info": "Text from here describes your description."
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from page"
        },
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom liquid",
          "info": "Add app snippets or other Liquid code to create advanced customizations. For product additional description, you can use {{ product.description }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Additional description",
      "blocks": [
        {
            "type": "description"
        },
        {
            "type": "description"
        },
        {
            "type": "description"
        }
      ]
    }
  ],
  "settings": [
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "background-4",
        "label": "Color scheme"
    },
    {
        "type": "range",
        "id": "pesto_section_padding_top",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top", 
        "default": 150
    },
    {
        "type": "range",
        "id": "pesto_section_padding_bottom",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 150
    }
  ]
}
{% endschema %}
