{% assign col_dextop = section.settings.col_settings %}
{% assign enable_collapsible = section.settings.enable_collapsible %}


<link rel="stylesheet" href="{{ 'ui-faq-section.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'ui-faq-section.css' | asset_url | stylesheet_tag }}</noscript>

<link rel="stylesheet" href="{{ 'ui-page-title.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'ui-page-title.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}

    {%- if section.settings.pesto_section_padding_top != blank -%}
        #shopify-section-{{section.id}} .page-title.faq-page {
            padding-top: {{ section.settings.pesto_section_padding_top }}px;
        }
    {%- endif -%}
    {%- if section.settings.pesto_section_padding_bottom != blank -%}
        #shopify-section-{{section.id}} .faq-page-section{
            padding-bottom: {{ section.settings.pesto_section_padding_bottom }}px;
        }
    {%- endif -%}
    
{%- endstyle -%}
    <div id="{{ section.id }}" class="faq-page-color color-{{ section.settings.color_scheme }}">
        
        {% if enable_collapsible == '1' %}
            <single-item-collaps class="single-item-collaps">
        {% endif %} 
            <div class="page-title faq-page centred">
                <div class="large-container">
                    <div class="text">
                        <h1>{{ section.settings.title_left }}</h1>
                        <p>{{ section.settings.left_content }}</p>
                    </div>
                </div>
            </div>
            {% if section.settings.layout_type == 'normal' %}
                <div class="faq-page-section pesto-faq-style-normal">
                    <div class="large-container">
                        <div class="row clearfix">
                            <div class="{% if section.settings.layout_column == 'single' %}col-lg-12{% else %}col-lg-12{% endif %} col-md-12 col-sm-12 conent-side">
                                {% if section.settings.layout_column == 'double' %}
                                    <div class="faq-content double-column">
                                        {% assign totalBlocks = section.blocks.size %}
                                        
                                        <div class="faq-inner-column">
                                            {% for block in section.blocks %}
                                                {% assign isOdd = forloop.index | modulo: 2 %}
                                                {% if isOdd == 1 %}
                                                    {% case block.type %}
                                                        {% when 'faq_items' %}
                                                            <div class="single-item">
                                                                <h3>{{ block.settings.title }} 
                                                                    {% if enable_collapsible == '1' %}
                                                                        <span class="plus">
                                                                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                            <path d="M9 1.5V16.5M16.5 9H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                            </svg>
                                                                        </span> 
                                                                        <span class="minus">
                                                                            <svg width="18" height="2" viewBox="0 0 18 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                            <path d="M16.5 1H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                            </svg>
                                                                        </span>
                                                                    {% endif %}
                                                                </h3>
                                                                <p>{{ block.settings.content }}</p>
                                                            </div>
                                                    {% endcase %}
                                                {% endif %}
                                            {% endfor %}
                                        </div>
    
                                        <div class="faq-inner-column">
                                            {% for block in section.blocks %}
                                                {% assign isEven = forloop.index | modulo: 2 %}
                                                {% if isEven == 0 %}
                                                    {% case block.type %}
                                                        {% when 'faq_items' %}
                                                            <div class="single-item">
                                                                <h3>{{ block.settings.title }} 
                                                                    {% if enable_collapsible == '1' %}
                                                                        <span class="plus">
                                                                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                            <path d="M9 1.5V16.5M16.5 9H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                            </svg>
                                                                        </span> 
                                                                        <span class="minus">
                                                                            <svg width="18" height="2" viewBox="0 0 18 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                            <path d="M16.5 1H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                            </svg>
                                                                        </span>
                                                                    {% endif %}
                                                                </h3>
                                                                <p>{{ block.settings.content }}</p>
                                                            </div>
                                                    {% endcase %}
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>

                                 {% elsif section.settings.layout_column == 'single' %}
                                    <div class="faq-content">
                                        {% for block in section.blocks %}
                                            {% case block.type %}
                                                {% when 'faq_items' %}
                                                    <div class="single-item">
                                                        <h3>{{ block.settings.title }} 
                                                            {% if enable_collapsible == '1' %}
                                                                <span class="plus">
                                                                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                    <path d="M9 1.5V16.5M16.5 9H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                    </svg>
                                                                </span> 
                                                                <span class="minus">
                                                                    <svg width="18" height="2" viewBox="0 0 18 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                    <path d="M16.5 1H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                    </svg>
                                                                </span>
                                                            {% endif %}
                                                        </h3>
                                                        <p>{{ block.settings.content }}</p>
                                                    </div>
                                            {% endcase %}
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% elsif section.settings.layout_type == 'box' %}
                <div class="faq-page-section pesto-faq-style-box{% if enable_collapsible == '2' %} pesto-faq-disable-collapsible{% endif %}">
                    <div class="large-container">
                        <div class="row clearfix">
                            <div class="{% if section.settings.layout_column == 'single' %}col-lg-12{% else %}col-lg-12{% endif %} col-md-12 col-sm-12 conent-side">

                                {% if section.settings.layout_column == 'double' %}
                                    <div class="faq-content pesto-faq-content-box double-column">
                                        {% assign totalBlocks = section.blocks.size %}
                                        
                                        <div class="faq-inner-column">
                                            {% for block in section.blocks %}
                                                {% assign isOdd = forloop.index | modulo: 2 %}
                                                {% if isOdd == 1 %}
                                                    {% case block.type %}
                                                        {% when 'faq_items' %}
                                                            <div class="single-item">
                                                                <h3>{{ block.settings.title }}
                                                                    {% if enable_collapsible == '1' %}
                                                                        <span class="plus">
                                                                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                            <path d="M9 1.5V16.5M16.5 9H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                            </svg>
                                                                        </span> 
                                                                        <span class="minus">
                                                                            <svg width="18" height="2" viewBox="0 0 18 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                            <path d="M16.5 1H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                            </svg>
                                                                        </span>
                                                                    {% endif %}
                                                                </h3>
                                                                <p>{{ block.settings.content }}</p>
                                                            </div>
                                                    {% endcase %}
                                                {% endif %}
                                            {% endfor %}
                                        </div>
    
                                        <div class="faq-inner-column">
                                            {% for block in section.blocks %}
                                                {% assign isEven = forloop.index | modulo: 2 %}
                                                {% if isEven == 0 %}
                                                    {% case block.type %}
                                                        {% when 'faq_items' %}
                                                            <div class="single-item">
                                                                <h3>{{ block.settings.title }}
                                                                    {% if enable_collapsible == '1' %}
                                                                        <span class="plus">
                                                                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                            <path d="M9 1.5V16.5M16.5 9H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                            </svg>
                                                                        </span> 
                                                                        <span class="minus">
                                                                            <svg width="18" height="2" viewBox="0 0 18 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                            <path d="M16.5 1H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                            </svg>
                                                                        </span>
                                                                    {% endif %}
                                                                </h3>
                                                                <p>{{ block.settings.content }}</p>
                                                            </div>
                                                    {% endcase %}
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>

                                 {% elsif section.settings.layout_column == 'single' %}
                                    <div class="faq-content pesto-faq-content-box">
                                        {% for block in section.blocks %}
                                            {% case block.type %}
                                                {% when 'faq_items' %}
                                                    <div class="single-item">
                                                        <h3>{{ block.settings.title }}
                                                            {% if enable_collapsible == '1' %}
                                                                <span class="plus">
                                                                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                    <path d="M9 1.5V16.5M16.5 9H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                    </svg>
                                                                </span> 
                                                                <span class="minus">
                                                                    <svg width="18" height="2" viewBox="0 0 18 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                    <path d="M16.5 1H1.5" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                                    </svg>
                                                                </span>
                                                            {% endif %}
                                                        </h3>
                                                        <p>{{ block.settings.content }}</p>
                                                    </div>
                                            {% endcase %}
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                        </div>
                    </div>
                </div>
            {% endif %} 
        {% if enable_collapsible == '1' %}
            </single-item-collaps>

        {% endif %} 
    </div>

{% schema %}
    {
        "name": "FAQ",
        "tag": "section",
        "class": "faq-main-area",
        "settings": [
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "default": "background-4",
                "label": "Color scheme"
            },
            {
                "type": "text",
                "id": "title_left",
                "label": "Heading",
                "default": "Tell your story"
            },
            {
                "type": "textarea",
                "id": "left_content",
                "label": "Content",
                "default": "Add your own custom content to give more information."
            },
            {
                "label": "Card type",
                "id": "layout_type",
                "type": "select",
                "default": "normal",
                "options": [
                  {
                    "value": "normal",
                    "label": "Normal"
                  },
                  {
                    "value": "box",
                    "label": "Box"
                  }
                ]
            },
            { 
                "label": "Columns",
                "id": "layout_column",
                "type": "select",
                "default": "single",
                "options": [
                  {
                    "value": "single",
                    "label": "Single"
                  },
                  {
                    "value": "double",
                    "label": "Double"
                  }
                ]
            },
            {
                "label": "Enable collapsible",
                "id": "enable_collapsible",
                "type": "select",
                "default": "2",
                "options": [
                  {
                    "value": "1",
                    "label": "Enable"
                  },
                  {
                    "value": "2",
                    "label": "Disable"
                  }
                ]
            },
            {
                "type": "header",
                "content": "Section padding"
            },
            {
                "type": "range",
                "id": "pesto_section_padding_top",
                "min": 0,
                "max": 200,
                "step": 10,
                "unit": "px",
                "label": "t:sections.all.padding.padding_top",
                "default": 150
            },
            {
                "type": "range",
                "id": "pesto_section_padding_bottom",
                "min": 0,
                "max": 200,
                "step": 10,
                "unit": "px",
                "label": "t:sections.all.padding.padding_bottom",
                "default": 150
            }
        ],
        "blocks": [
            {
                "type": "@app"
            },
            {
                "name": "Items",
                "type": "faq_items",
                "settings": [
                    {
                        "type": "text",
                        "id": "title",
                        "label": "Heading",
                        "default": "Question title"
                    },
                    {
                        "type": "textarea",
                        "id": "content",
                        "label": "Content",
                        "default": "Question answer"
                    }
                ]
            }
        ],
        "presets": [
            {
                "name": "FAQ",
                "blocks": [
                    {
                        "type": "faq_items"
                    },
                    {
                        "type": "faq_items"
                    },
                    {
                        "type": "faq_items"
                    },
                    {
                        "type": "faq_items"
                    }
                ]
            }
        ]
    }
{% endschema %}