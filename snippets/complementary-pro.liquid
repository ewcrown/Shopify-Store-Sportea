
<product-recommendations class="complementary-products" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.products_per_page }}&intent=complementary">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div class="recommendations-complementary-products-list" role="list">
            {%- for product in recommendations.products -%}
                <div class="recommendations-complementary-products-item">
                    <a class="allover-rc-item-link" href="{{ product.url | default: '#' }}"></a>
                    <figure class="recommendations-complementary-products-item-img">
                        <img
                            srcset="
                                {%- if product.featured_media.width >= 165 -%}{{ product.featured_media | img_url: '165x' }} 165w,{%- endif -%}
                                {%- if product.featured_media.width >= 360 -%}{{ product.featured_media | img_url: '360x' }} 360w,{%- endif -%}
                                {%- if product.featured_media.width >= 533 -%}{{ product.featured_media | img_url: '533x' }} 533w,{%- endif -%}
                                {%- if product.featured_media.width >= 720 -%}{{ product.featured_media | img_url: '720x' }} 720w,{%- endif -%}
                                {%- if product.featured_media.width >= 940 -%}{{ product.featured_media | img_url: '940x' }} 940w,{%- endif -%}
                                {%- if product.featured_media.width >= 1066 -%}{{ product.featured_media | img_url: '1066x' }} 1066w,{%- endif -%}
                                {{ product.featured_media | img_url: 'master' }} {{ product.featured_media.width }}w
                                "
                            data-src="{{ product.featured_media | img_url: '533x' }}"
                            alt="{{ product.featured_media.alt | escape }}"
                            class="img-reduce lazyload"
                            width="{{ product.featured_media.width }}"
                            height="{{ product.featured_media.height }}"
                        >
                    </figure>
                    <div class="recommendations-complementary-products-item-title">
                        <h4><a href="{{ product.url | default: '#' }}">{{ product.title | escape }}</a></h4>
                    </div>
                </div>
            {%- endfor -%}
        </div>
    {%- endif -%}
  </product-recommendations>