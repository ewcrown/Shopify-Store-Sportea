
    <div
        id="{{ section.id }}"
        loading="lazy"
        class="lazyload menu-section style-two color-{{ section.settings.color_scheme }}"
        
    >
        {% if section.settings.sections_bg != blank %}
            <div
                class="overlay-object-section-bg"
            >
                {{ section.settings.sections_bg | image_url: width: 7680 | image_tag: loading: 'lazy', class: 'lazyload' }}
            </div>
        {%- endif -%}
        <div class="large-container">
            <div class="sec-title centred">
                <h2>{{ section.settings.title }}</h2>
            </div>
            {% assign count = 0 %}
            {% for block in section.blocks %}
                {% assign count = count | plus: 1 %}
            {% endfor %}
            <div class="row clearfix">
                    {%- for block in section.blocks -%}
                        {%- case block.type -%}
                            {%- when 'product_collections'-%}
                                <div class="{% if count != 1 %}col-lg-6 col-md-12 {% else %}col-lg-12 col-md-12 {% endif %}col-sm-12 menu-column">
                                    {%- assign product_collection = block.settings.product_collection -%}
                                    <div class="{% if forloop.first == true %}menu-box-one{% else %}menu-box-two{% endif %} ">
                                        
                                        {%- if block.settings.product_collection != blank -%}
                                            <div class="menu-title centred">
                                                <h2>{{ block.settings.product_collection.title }}</h2>
                                            </div>
                                        {% else %}
                                            <div class="menu-title centred">
                                                <h2>{{ 'highlighted_collection.collection_name' | t }}</h2>
                                            </div>
                                        {% endif %}
                                        
                                        <ul class="menu-list clearfix">
                                            {%- if block.settings.product_collection != blank -%}
                                                {%- for product in product_collection.products limit: block.settings.product_collection_limit_one -%}
                                                    <li>
                                                        <a href="{{ product.url }}" class="the-overlay-link"></a>
                                                        <div class="item-inner {% if product.featured_media %} menu-list-have-images-area{% else %} menu-list-not-images-area{% endif %}">

                                                            {%- if product.featured_media -%}
                                                                <div class="item-thumb">
                                                                    <img
                                                                        srcset="{%- if product.featured_media.width >= 165 -%}{{ product.featured_media | img_url: '165x' }} 165w,{%- endif -%}
                                                                            {%- if product.featured_media.width >= 360 -%}{{ product.featured_media | img_url: '360x' }} 360w,{%- endif -%}
                                                                            {%- if product.featured_media.width >= 533 -%}{{ product.featured_media | img_url: '533x' }} 533w,{%- endif -%}
                                                                            {%- if product.featured_media.width >= 720 -%}{{ product.featured_media | img_url: '720x' }} 720w,{%- endif -%}
                                                                            {%- if product.featured_media.width >= 940 -%}{{ product.featured_media | img_url: '940x' }} 940w,{%- endif -%}
                                                                            {%- if product.featured_media.width >= 1066 -%}{{ product.featured_media | img_url: '1066x' }} 1066w,{%- endif -%}
                                                                            {{ product.featured_media | img_url: 'master' }} {{ product.featured_media.width }}w"
                                                                        data-src="{{ product.featured_media | img_url: '533x' }}"
                                                                        alt="{{ product.featured_media.alt | escape }}"
                                                                        loading="lazy"  class="lazyload img-reduce"
                                                                        width="{{ product.featured_media.width }}"
                                                                        height="{{ product.featured_media.height }}"
                                                                    />
                                                                </div>
                                                        {%- else -%}
                                                                <div class="menu-list-not-images"></div>
                                                        {%- endif -%}

                                                            <div class="item-right-info">
                                                                <div class="item-desc">
                                                                    <a href="{{ product.url }}" class="text">
                                                                        <h3>{{ product.title }}</h3>
                                                                    </a>
                                                                    {% if product.variants.size > 1 %}
                                                                        <p>
                                                                            {% for product_option in product.options_with_values %}
                                                                                {{ product_option.name }}:
                                                                                {% for value in product_option.values %}
                                                                                    {{ value }}
                                                                                {% endfor %}
                                                                            {% endfor %}
                                                                        </p>
                                                                    {% endif %}
                                                                </div>
                                                                <div class="price-area-menu">{% render 'price-raw', product: product %}</div>
                                                            </div>
                                                        </div>
                                                    </li>
                                                {% endfor %} 
                                            {%- else -%}
                                                {%- for i in (1..block.settings.product_collection_limit_one) -%}
                                                    <li>
                                                        <div class="item-inner">
                                                            <div class="item-thumb">
                                                                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg-all-collection' }}
                                                            </div>
                                                            <div class="item-right-info">
                                                                <div class="item-desc">
                                                                    <h3>{{ 'highlighted_collection.product_title' | t }}</h3>
                                                                    <p>{{ 'highlighted_collection.size' | t }}</p>
                                                                </div>
                                                                <div class="price-area-menu">
                                                                    {{ 'highlighted_collection.product_price' | t }}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </li>
                                                {%- endfor -%}

                                            {%- endif -%}
                                        </ul>
                                    </div>
                                </div>
                        {% endcase %}
                    {% endfor %}
            </div>
        </div>
    </div>