{% comment %}
Renders sub popup

Usage:
{% render 'sub-popup' %}
{% endcomment %}


{% assign show_again_delay = section.settings.show_again_delay %}
{% assign show_again_rif_after = section.settings.show_again_rif_after %}
{% assign display_mode_popup = section.settings.display_mode_popup %}

{% if display_mode_popup == 'display_mode_popup_test_disable' %}
{% assign display_mode_popup_val = false %}
{% else %}
{% assign display_mode_popup_val = true %}
{% endif %}



{%- style -%}
{% for block in section.blocks %}
{% case block.type %}
{% when 'news_popup_empty_space' %}
#shopify-block-{{ block.id }}.news-popup-empty-space{
min-height: {{ block.settings.news_popup_space_desktop }}px;
}
{% endcase %}
{% endfor %}
{%- endstyle -%}


<renders-sub-popup id="renders-sub-popup" class="renders-sub-popup-area color-{{ section.settings.color_scheme }}"
    mode="{{ display_mode_popup_val }}" delay="{{ show_again_delay }}" expiry="{{ show_again_rif_after }}">
    <div id="renders-overlay" class="renders__overlay"></div>
    <div class="renders-sub-popup__content{% if section.settings.news_popup_image %} news-popup-with-image{% endif %}">

        {% comment %} <h2>Popup newsletter</h2> {% endcomment %}
        <button class="newsletter-sub-popup-close-btn" data-close="close-btn">
            <svg width="12" height="13" viewBox="0 0 12 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                    d="M7.06065 6.82812L11.7803 2.10845C11.85 2.0388 11.9052 1.95612 11.9429 1.86513C11.9806 1.77414 12 1.67661 12 1.57812C12 1.47963 11.9806 1.3821 11.9429 1.29111C11.9052 1.20012 11.85 1.11744 11.7803 1.04779C11.7107 0.97815 11.628 0.922906 11.537 0.885215C11.446 0.847524 11.3485 0.828125 11.25 0.828125C11.1515 0.828125 11.054 0.847524 10.963 0.885215C10.872 0.922906 10.7893 0.97815 10.7197 1.04779L6 5.76747L1.28032 1.04779C1.21068 0.97815 1.128 0.922906 1.03701 0.885215C0.946012 0.847524 0.848486 0.828125 0.749995 0.828125C0.651504 0.828125 0.553978 0.847524 0.462984 0.885215C0.371991 0.922906 0.289312 0.97815 0.219669 1.04779C0.150025 1.11744 0.0947807 1.20012 0.05709 1.29111C0.0193992 1.3821 -7.33813e-10 1.47963 0 1.57812C7.33813e-10 1.67661 0.0193992 1.77414 0.05709 1.86513C0.0947807 1.95612 0.150025 2.0388 0.219669 2.10845L4.93935 6.82812L0.219669 11.5478C0.150025 11.6174 0.0947807 11.7001 0.05709 11.7911C0.0193992 11.8821 0 11.9796 0 12.0781C0 12.1766 0.0193992 12.2741 0.05709 12.3651C0.0947807 12.4561 0.150025 12.5388 0.219669 12.6085C0.289312 12.6781 0.371991 12.7333 0.462984 12.771C0.553978 12.8087 0.651504 12.8281 0.749995 12.8281C0.848486 12.8281 0.946012 12.8087 1.03701 12.771C1.128 12.7333 1.21068 12.6781 1.28032 12.6085L6 7.88878L10.7197 12.6085C10.7893 12.6781 10.872 12.7333 10.963 12.771C11.054 12.8087 11.1515 12.8281 11.25 12.8281C11.3485 12.8281 11.446 12.8087 11.537 12.771C11.628 12.7333 11.7107 12.6781 11.7803 12.6085C11.85 12.5388 11.9052 12.4561 11.9429 12.3651C11.9806 12.2741 12 12.1766 12 12.0781C12 11.9796 11.9806 11.8821 11.9429 11.7911C11.9052 11.7001 11.85 11.6174 11.7803 11.5478L7.06065 6.82812Z"
                    fill="currentColor" />
            </svg>
        </button>

        <div class="newsletter-render-popup-inner-content">
            <div class="newsletter-render-popu-inner-content-left">
                {% for block in section.blocks %}
                {% case block.type %}
                {% when 'news_pop_logo_image' %}
                {% if block.settings.news_popup_logo_image != blank %}
                <div class="news-popup-logo-image">
                    <figure class="image-box">
                        <img data-src="{{ block.settings.news_popup_logo_image | img_url: 'master' }}" loading="lazy"
                            class="lazyload" width="{{ block.settings.news_popup_logo_image.width }}"
                            height="{{ block.settings.news_popup_logo_image.height }}"
                            alt="{{ block.settings.news_popup_logo_image.alt | escape }}">
                    </figure>
                </div>
                {% endif %}
                {% when 'news_popup_empty_space' %}
                <div id="shopify-block-{{ block.id }}" class="news-popup-empty-space"></div>
                {% when 'news_pop_sub_heading' %}
                <div class="news-popup-sub-heading">
                    <h5>{{ block.settings.news_pop_subheading }}</h5>
                </div>
                {% when 'news_popup_heading' %}
                <div class="news-popup-heading">
                    <h3>{{ block.settings.popup_heading_title }}</h3>
                    <p>{{ block.settings.popup_heading_content }}</p>
                </div>
                {% when 'news_pop_form_area' %}
                <div class="news-popup-form">
                    {% form 'customer', class: 'newsletter-form' %}
                    <div class="form-group  {% if block.settings.popup_form_label %}has-label{% endif %}">
                        {% if block.settings.popup_form_label %}
                        <label for="NewsletterForm--{{ section.id }}">Email</label>
                        {% endif %}
                        <div class="form-inner">
                            <input id="NewsletterForm--{{ section.id }}" type="email" name="contact[email]"
                                class="field__input" value="{{ form.email }}" aria-required="true" autocorrect="off"
                                autocapitalize="off" autocomplete="email" {% if block.settings.form_placeholder !=blank
                                %} placeholder="{{ block.settings.form_placeholder }}" {% endif %} {% if form.errors %}
                                autofocus aria-invalid="true" aria-describedby="Newsletter-error--{{ section.id }}" {%
                                elsif form.posted_successfully? %}
                                aria-describedby="Newsletter-success--{{ section.id }}" {% endif %} required>
                            <button type="submit">{{ block.settings.form_btn }}</button>
                        </div>
                    </div>
                    {%- if form.errors -%}
                    <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">{%
                        render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{
                        form.errors.messages['email'] }}</small>
                    {%- endif -%}
                    {%- if form.posted_successfully? -%}
                    <h3 class="newsletter-form__message newsletter-form__message--success form__message"
                        id="Newsletter-success--{{ section.id }}" tabindex="-1" autofocus>{% render 'icon-success' %}{{
                        'newsletter.success' | t }}</h3>
                    {%- endif -%}
                    {% endform %}
                </div>
                {% when 'news_pop_lower_content' %}
                <div class="news-pop-lower-text">
                    <p>{{ block.settings.news_pop_lower_content_text }}</p>
                </div>
                {% when 'news_pop_social_icon' %}
                <div class="news-pop-social-icon">
                    <ul aria-label="{{ 'general.social_lvl_list' | t }}"
                        class="social-links list list-social list-unstyled" role="list">
                        {%- if settings.social_twitter_link != blank -%}
                        <li class="list-social__item">
                            <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_twitter_link }}"
                                class="list-social__link link">
                                {%- render 'icon-twitter' -%}
                                <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                            </a>
                        </li>
                        {%- endif -%}
                        {%- if settings.social_facebook_link != blank -%}
                        <li class="list-social__item">
                            <a aria-label="{{ 'general.link_to_social' | t }}"
                                href="{{ settings.social_facebook_link }}" class="list-social__link link">
                                {%- render 'icon-facebook' -%}
                                <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                            </a>
                        </li>
                        {%- endif -%}
                        {%- if settings.social_pinterest_link != blank -%}
                        <li class="list-social__item">
                            <a aria-label="{{ 'general.link_to_social' | t }}"
                                href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                                {%- render 'icon-pinterest' -%}
                                <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                            </a>
                        </li>
                        {%- endif -%}
                        {%- if settings.social_instagram_link != blank -%}
                        <li class="list-social__item">
                            <a aria-label="{{ 'general.link_to_social' | t }}"
                                href="{{ settings.social_instagram_link }}" class="list-social__link link">
                                {%- render 'icon-instagram' -%}
                                <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                            </a>
                        </li>
                        {%- endif -%}
                        {%- if settings.social_tiktok_link != blank -%}
                        <li class="list-social__item">
                            <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_tiktok_link }}"
                                class="list-social__link link">
                                {%- render 'icon-tiktok' -%}
                                <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                            </a>
                        </li>
                        {%- endif -%}
                        {%- if settings.social_tumblr_link != blank -%}
                        <li class="list-social__item">
                            <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_tumblr_link }}"
                                class="list-social__link link">
                                {%- render 'icon-tumblr' -%}
                                <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                            </a>
                        </li>
                        {%- endif -%}
                        {%- if settings.social_snapchat_link != blank -%}
                        <li class="list-social__item">
                            <a aria-label="{{ 'general.link_to_social' | t }}"
                                href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                                {%- render 'icon-snapchat' -%}
                                <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                            </a>
                        </li>
                        {%- endif -%}
                        {%- if settings.social_youtube_link != blank -%}
                        <li class="list-social__item">
                            <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_youtube_link }}"
                                class="list-social__link link">
                                {%- render 'icon-youtube' -%}
                                <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                            </a>
                        </li>
                        {%- endif -%}
                        {%- if settings.social_vimeo_link != blank -%}
                        <li class="list-social__item">
                            <a aria-label="{{ 'general.link_to_social' | t }}" href="{{ settings.social_vimeo_link }}"
                                class="list-social__link link">
                                {%- render 'icon-vimeo' -%}
                                <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                            </a>
                        </li>
                        {%- endif -%}
                    </ul>
                </div>
                {% endcase %}
                {% endfor %}
            </div>
            {%- if section.settings.news_popup_image -%}
            <div class="newsletter-render-popu-inner-content-right">
                <figure class="image-box">
                    {%- if section.settings.news_popup_image != blank -%}
                    {{ section.settings.news_popup_image | image_url: width: section.settings.news_popup_image.width |
                    image_tag: loading: 'lazy', class: 'lazyload' }}
                    {%- endif -%}
                </figure>
            </div>
            {%- endif -%}
        </div>
    </div>
</renders-sub-popup>









































