
<nav  class="main-menu-dex-none main-menu navbar-expand-md navbar-light">
    <div class="collapse navbar-collapse show clearfix" id="navbarSupportedContent">
        <ul class="navigation clearfix">
            {%- for link in section.settings.header_menu.links -%}
                {%- if link.links != blank -%}
                    <li class="dropdown">
                        <a href="{{ link.url }}">{{ link.title }}</a>
                        <button class="dropdown-btn">
                            <span class="fas fa-angle-down">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-down" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                                </svg>
                            </span>
                        </button>
                        <ul>
                            {%- for childlink in link.links -%}
                                {%- if childlink.links != blank -%}
                                    <li class="dropdown dropdown-three-area">
                                        <a href="{{ childlink.url }}">{{ childlink.title }}</a>
                                        <button class="dropdown-btn">
                                            <span class="fas fa-angle-down">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-down" viewBox="0 0 16 16">
                                                    <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                                                </svg>
                                            </span>
                                        </button>
                                        {%- if childlink.links != blank -%}
                                            <ul>
                                                {%- for threelink in childlink.links -%}
                                                    <li class="dropdown-three">
                                                        <a href="{{ threelink.url }}">{{ threelink.title }}</a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {%- endif -%}
                                    </li>
                                {%- elsif childlink.links == blank -%}
                                    <li>
                                        <a href="{{ childlink.url }}">{{ childlink.title }}</a>
                                    </li>
                                {% endif %}

                            {% endfor %}
                        </ul>
                    </li>
                {%- elsif link.links == blank -%}
                    <li>
                        <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
</nav>