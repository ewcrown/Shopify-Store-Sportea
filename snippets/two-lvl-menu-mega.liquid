
{% if link.links != blank %}
    <ul class="mega-menu-inner-menu menu-list" >
        {%- for childlink in link.links -%}
            {%- if childlink.links != blank -%}
                <li>
                    <div class="drop-down-item collapsible-dropdown">
                        <a href="{{ childlink.url }}"><span>{{ childlink.title }}</span>
                        </a>
                        <button class="icon collapsible-dropdown-prnt">
                            <svg class="desktop-arrow" width="14" height="8" viewBox="0 0 14 8" role="none"
                                fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M13.25 0.875L7 7.125L0.75 0.875" stroke="currentColor"
                                    stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <svg class="mobile-arrow" width="8" height="14" viewBox="0 0 8 14" role="none"
                                fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M0.875 0.75L7.125 7L0.875 13.25" stroke="currentColor"
                                    stroke-width="1.1875" stroke-linecap="round"
                                    stroke-linejoin="round" />
                            </svg>
                        </button>
                    </div>
                    <ul>
                        {%- for threelink in childlink.links -%}
                            <li>
                                <a href="{{ threelink.url }}"><span>{{ threelink.title }}</span></a>
                            </li>
                        {% endfor %}
                    </ul>
                </li>
            {%- else -%}
                <li>
                    <a href="{{ childlink.url }}"><span>{{ childlink.title }}</span></a>
                </li>
            {% endif %}
        {% endfor %}
    </ul>
{% endif %}