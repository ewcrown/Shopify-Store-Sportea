
    {%- if product.available == false -%}
      <div class="card__badge">
        <span id="Badge-{{ section_id }}-{{ product.id }}" class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}">{{ 'products.product.sold_out' | t }}</span>
      </div>
    {%- elsif product.compare_at_price > product.price and product.available -%}
      <div class="card__badge">
        <span id="Badge-{{ section_id }}-{{ product.id }}" class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}">{{ 'products.product.on_sale' | t }}</span>
      </div>
    {%- endif -%}

