{%- assign show_blog_readmore = section.settings.show_blog_readmore %}
<div class="news-block-two bottom default-list {% if article.image == blank or show_featured_image == false %} no-feature-image-me{% endif %}">
  <div class="inner-box">
    {%- if show_featured_image == true -%}
      <figure class="image-box">
        <a href="{{ article.url }}">
          {% if article.image != blank %}
            <img
              data-src="{{ article.image | img_url: 'master' }}"
              loading="lazy"  class="lazyload"
              width="{{ article.image.width }}"
              height="{{ article.image.height }}"
              alt="{{ article.image.alt | escape }}"
            >
          {% endif %}
        </a>
      </figure>
    {% endif %}
      <div class="content-box"> 
          <ul class="other-option clearfix">
            {%- if section.settings.show_blog_author == true -%}
              <li>
                <svg width="14" height="18" viewBox="0 0 14 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10.1242 4C10.1242 4.8288 9.79493 5.62366 9.20887 6.20971C8.62282 6.79576 7.82797 7.125 6.99917 7.125C6.17036 7.125 5.37551 6.79576 4.78946 6.20971C4.20341 5.62366 3.87417 4.8288 3.87417 4C3.87417 3.1712 4.20341 2.37634 4.78946 1.79029C5.37551 1.20424 6.17036 0.875 6.99917 0.875C7.82797 0.875 8.62282 1.20424 9.20887 1.79029C9.79493 2.37634 10.1242 3.1712 10.1242 4ZM0.75 15.765C0.776779 14.1253 1.44695 12.5618 2.61598 11.4117C3.78501 10.2616 5.35924 9.61706 6.99917 9.61706C8.63909 9.61706 10.2133 10.2616 11.3824 11.4117C12.5514 12.5618 13.2216 14.1253 13.2483 15.765C11.2878 16.664 9.15596 17.1279 6.99917 17.125C4.76917 17.125 2.6525 16.6383 0.75 15.765Z" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

                {{ 'blogs.by' | t }} <a href="{{ article.url }}"><span>{{ article.author }}</span></a>
              </li>
            {% endif %}
            {%- if show_blog_date == true -%}
                <li>
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g opacity="0.8">
                    <path d="M5.625 2.5V4.375M14.375 2.5V4.375M2.5 15.625V6.25C2.5 5.75272 2.69754 5.27581 3.04917 4.92417C3.40081 4.57254 3.87772 4.375 4.375 4.375H15.625C16.1223 4.375 16.5992 4.57254 16.9508 4.92417C17.3025 5.27581 17.5 5.75272 17.5 6.25V15.625M2.5 15.625C2.5 16.1223 2.69754 16.5992 3.04917 16.9508C3.40081 17.3025 3.87772 17.5 4.375 17.5H15.625C16.1223 17.5 16.5992 17.3025 16.9508 16.9508C17.3025 16.5992 17.5 16.1223 17.5 15.625M2.5 15.625V9.375C2.5 8.87772 2.69754 8.40081 3.04917 8.04917C3.40081 7.69754 3.87772 7.5 4.375 7.5H15.625C16.1223 7.5 16.5992 7.69754 16.9508 8.04917C17.3025 8.40081 17.5 8.87772 17.5 9.375V15.625" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </g>
                    </svg>                      
                  {{ article.published_at | date: "%b %d, %y" }}
                </li>
            {%- endif -%}
          </ul>
          <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <div class="post-ex-trun ">
            {{ article.excerpt_or_content | strip_html | truncatewords: 30  }}
          </div>

          {% if show_blog_readmore or section.settings.show_blog_comments == true %}
            <div class="content-box-footer">

            {%- if show_blog_readmore -%}
              <div class="read_more_log_list">
                <a href="{{ article.url }}">
                  {{ 'article_area.article_read_more' | t }}
                </a>
              </div>
            {%- endif -%}
  
            {%- if section.settings.show_blog_comments == true -%}
              <ul class="post-info clearfix">
                  <li class="comment-on-post-list">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chat" viewBox="0 0 16 16">
                      <path d="M2.678 11.894a1 1 0 0 1 .287.801 10.97 10.97 0 0 1-.398 2c1.395-.323 2.247-.697 2.634-.893a1 1 0 0 1 .71-.074A8.06 8.06 0 0 0 8 14c3.996 0 7-2.807 7-6 0-3.192-3.004-6-7-6S1 4.808 1 8c0 1.468.617 2.83 1.678 3.894zm-.493 3.905a21.682 21.682 0 0 1-.713.129c-.2.032-.352-.176-.273-.362a9.68 9.68 0 0 0 .244-.637l.003-.01c.248-.72.45-1.548.524-2.319C.743 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7-3.582 7-8 7a9.06 9.06 0 0 1-2.347-.306c-.52.263-1.639.742-3.468 1.105z"/>
                    </svg>
                    <a href="{{ article.url }}">{{ article.comments_count }} {{ 'blogs.blog_comments' | t }}</a>
                  </li>
              </ul>
            {% endif %}

            </div>
          {% endif %}
         

          
      </div>
  </div>
</div>